@inherits LayoutComponentBase
<div class="driver-shell"><header><a href="/driver"><span>LV</span><strong>Driver</strong></a><em>London VIP Cars</em></header><main>@Body</main><nav aria-label="Driver navigation"><a href="/driver">⌂<span>Home</span></a><a href="/driver/jobs">▣<span>Jobs</span></a><a href="/driver/map">⌖<span>Map</span></a><a href="/driver/earnings">£<span>Earnings</span></a><a href="/driver/notifications">●<span>Alerts</span></a><a href="/driver/profile">☰<span>More</span></a></nav></div>
<style>.driver-shell{min-height:100vh;background:#f3f5f3;color:#173f36;padding-bottom:5rem}.driver-shell>header{position:sticky;top:0;z-index:5;display:flex;justify-content:space-between;align-items:center;padding:.85rem 1rem;background:#113a32;color:#fff}.driver-shell>header a{display:flex;align-items:center;gap:.6rem;color:#fff;text-decoration:none}.driver-shell>header a span{display:grid;place-items:center;width:2.2rem;height:2.2rem;border:1px solid #cfad67;border-radius:50%;color:#e1c27d}.driver-shell>header em{font-size:.7rem;font-style:normal;color:#bfd0ca}.driver-shell>main{max-width:54rem;margin:auto;padding:1rem}.driver-shell>nav{position:fixed;z-index:10;bottom:0;left:0;right:0;display:grid;grid-template-columns:repeat(6,1fr);background:#fff;border-top:1px solid #d7dfdc;padding:max(.4rem,env(safe-area-inset-bottom)) .25rem}.driver-shell>nav a{display:grid;place-items:center;color:#49655e;text-decoration:none;font-size:1.05rem;min-height:3.25rem}.driver-shell>nav span{font-size:.58rem}@@media(min-width:800px){.driver-shell>nav{left:50%;transform:translateX(-50%);max-width:54rem;border:1px solid #d7dfdc;border-radius:1rem 1rem 0 0}}</style>
