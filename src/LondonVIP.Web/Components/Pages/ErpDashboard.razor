@page "/erp"
@layout AdminLayout

<PageTitle>Operations Dashboard | London VIP Cars ERP</PageTitle>

<div class="dashboard-page">
    <header class="dashboard-heading">
        <div><span class="dashboard-eyebrow">Friday, 28 August</span><h1>Operations dashboard</h1><p>A clear view of today's London VIP Cars operation.</p></div>
        <span class="demo-label"><i></i> Demonstration data</span>
    </header>

    <div class="dashboard-notice"><strong>Dashboard preview</strong> All values on this page are placeholder data for layout planning and are not connected to live operations.</div>

    <section class="summary-grid" aria-label="Daily summary">
        @foreach (var item in Summary)
        {
            <article><div class="summary-top"><span>@item.Label</span><i class="@item.Tone">@item.Icon</i></div><strong>@item.Value</strong><small>@item.Note</small></article>
        }
    </section>

    <div class="dashboard-grid">
        <section class="dashboard-card next-jobs">
            <header><div><span class="card-kicker">Dispatch outlook</span><h2>Next 2 Hours</h2></div><a href="/erp/dispatch">Open dispatch &rarr;</a></header>
            <div class="job-list">
                @foreach (var job in UpcomingJobs)
                {
                    <article><time>@job.Time</time><span class="route-dot"></span><div><strong>@job.Route</strong><small>@job.Vehicle &bull; Demo booking</small></div><span class="job-status @job.Tone">@job.Status</span></article>
                }
            </div>
        </section>

        <DashboardPanel Title="Flight Delays" Kicker="Airport operations" Link="/erp/airport-operations" Empty="No live flight feed connected">
            <div class="mini-alert amber"><span>!</span><div><strong>Flight integration pending</strong><small>Connect a provider to monitor arrival changes.</small></div></div>
        </DashboardPanel>

        <DashboardPanel Title="Traffic Alerts" Kicker="Journey conditions" Link="/erp/journey-intelligence" Empty="No live traffic feed connected">
            <div class="mini-alert neutral"><span>&#8594;</span><div><strong>Route monitoring placeholder</strong><small>Live journey risk will appear here later.</small></div></div>
        </DashboardPanel>

        <DashboardPanel Title="New Leads" Kicker="CRM" Link="/erp/leads" Empty="Demo lead activity">
            <ul class="compact-list"><li><span>Website quote</span><strong>3 demo</strong></li><li><span>Corporate enquiry</span><strong>1 demo</strong></li><li><span>Follow-up due</span><strong>2 demo</strong></li></ul>
        </DashboardPanel>

        <DashboardPanel Title="Outstanding Payments" Kicker="Finance" Link="/erp/payments" Empty="Payment processing not connected">
            <div class="metric-block"><strong>&pound;0.00</strong><span>Live balance unavailable</span></div>
        </DashboardPanel>

        <DashboardPanel Title="Driver Alerts" Kicker="Fleet &amp; drivers" Link="/erp/drivers" Empty="Demo driver alerts">
            <ul class="compact-list"><li><span>Availability check</span><strong>2 demo</strong></li><li><span>Account review</span><strong>1 demo</strong></li></ul>
        </DashboardPanel>

        <DashboardPanel Title="Expiring Documents" Kicker="Compliance" Link="/erp/documents" Empty="Demo compliance reminders">
            <ul class="compact-list"><li><span>Within 30 days</span><strong>2 demo</strong></li><li><span>Within 60 days</span><strong>4 demo</strong></li></ul>
        </DashboardPanel>
    </div>
</div>

@code {
    private static readonly (string Label, string Value, string Note, string Icon, string Tone)[] Summary =
    [
        ("Bookings Today", "12", "Demo total", "B", "green"),
        ("Revenue Today", "£1,840", "Demo value", "£", "gold"),
        ("Unassigned Jobs", "3", "Demo attention", "!", "red"),
        ("Drivers Available", "8", "Demo availability", "D", "green"),
        ("Airport Pickups", "7", "Demo total", "A", "blue"),
        ("New Leads", "6", "Demo enquiries", "L", "gold")
    ];
    private static readonly (string Time, string Route, string Vehicle, string Status, string Tone)[] UpcomingJobs =
    [
        ("09:30", "Heathrow T5 → Mayfair", "Saloon", "Assigned", "good"),
        ("10:05", "Chelsea → Gatwick N", "Estate", "Unassigned", "attention"),
        ("10:40", "Stansted → Hammersmith", "MPV", "Confirmed", "neutral")
    ];
}
