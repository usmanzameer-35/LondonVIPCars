@page "/driver/jobs"
@page "/driver/jobs/{JobId:guid}"
@page "/driver/earnings"
@page "/driver/documents"
@page "/driver/vehicle"
@page "/driver/notifications"
@page "/driver/availability"
@page "/driver/profile"
@page "/driver/map"
@attribute [Authorize(Roles="Driver")]
@layout DriverLayout
@rendermode InteractiveServer
@using LondonVIP.Shared.Drivers
@using LondonVIP.Shared.Models
@inject IHttpClientFactory Clients
@inject NavigationManager Navigation
<PageTitle>Driver Workspace | London VIP Cars</PageTitle>
<div class="workspace"><header><span>Driver workspace</span><h1>@Title</h1></header>@if(loading){<p>Loading…</p>}else if(JobId is not null&&job is not null){<article class="job"><span>@job.Status</span><h2>@job.BookingReference</h2><time>@job.PickupDateTime.LocalDateTime.ToString("ddd dd MMM · HH:mm")</time><h3>Pickup</h3><p>@job.PickupAddress</p><h3>Destination</h3><p>@job.Destination</p><h3>Passenger</h3><p>@job.PassengerName · <a href="tel:@job.PassengerPhone">Call customer</a></p><p>@job.PassengerCount passengers · @job.LuggageCount luggage · @job.VehicleType</p>@if(job.FlightNumber is not null){<p>Flight @job.FlightNumber @(job.MeetAndGreet?"· Meet & Greet":"")</p>}<div class="job-actions">@foreach(var action in Actions(job.Status)){<button @onclick="()=>Run(action.Path)">@action.Label</button>}<a target="_blank" href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(job.PickupAddress)">Open maps</a></div></article>}else if(section=="jobs"){@foreach(var item in jobs){<a class="list" href="/driver/jobs/@item.Id"><div><strong>@item.BookingReference</strong><span>@item.PickupDateTime.LocalDateTime.ToString("ddd HH:mm") · @item.Status</span></div><em>›</em></a>}@if(jobs.Count==0){<p>No assigned jobs.</p>}}else if(section=="earnings"&&earnings is not null){<section class="cards"><article><span>Today</span><strong>@earnings.GrossToday.ToString("C")</strong><small>@earnings.CompletedJobsToday completed jobs</small></article><article><span>This week</span><strong>@earnings.GrossWeek.ToString("C")</strong><small>@earnings.CompletedJobsWeek completed jobs</small></article><article><span>Commission</span><strong>@(earnings.CommissionWeek?.ToString("C")??"Unavailable")</strong><small>@(earnings.CommissionConfigured?"Configured company rate":"No configured calculation")</small></article></section>}else if(section=="documents"){@foreach(var doc in documents){<div class="list"><div><strong>@doc.Type</strong><span>@(doc.Reference??"No reference") · @(doc.ExpiryDate?.ToString("dd MMM yyyy")??"No expiry")</span></div><em>@doc.Status</em></div>}}else if(section=="notifications"){@foreach(var note in notifications){<div class="list"><div><strong>@note.Subject</strong><span>@note.Body</span><small>@note.CreatedAt.LocalDateTime.ToString("dd MMM HH:mm")</small></div></div>}}else if(profile is not null){<article><h2>@profile.Name</h2><p>@profile.Email<br/>@profile.Phone</p><p>Driver number: @(profile.DriverNumber??"Not set")</p><p>Status: @profile.Status · Compliance: @profile.ComplianceStatus</p>@if(profile.Vehicle is not null){<h3>@profile.Vehicle.Registration</h3><p>@profile.Vehicle.Make @profile.Vehicle.Model · @profile.Vehicle.VehicleType</p><p>Vehicle compliance: @profile.Vehicle.ComplianceStatus</p>}</article>}</div>
<style>.workspace{display:grid;gap:1rem}.workspace header span{font-size:.65rem;text-transform:uppercase;color:#9b762e}.workspace h1{font:2rem Georgia,serif}.workspace article,.list{background:#fff;border:1px solid #dce4e1;border-radius:.8rem;padding:1rem}.list{display:flex;justify-content:space-between;align-items:center;color:#173f36;text-decoration:none;margin:.6rem 0}.list div{display:grid}.list span,.list small{color:#6d7c78;font-size:.68rem}.list em{font-style:normal;color:#997329}.job>span{color:#997329;text-transform:uppercase}.job h2{font:1.6rem Georgia,serif}.job h3{font-size:.7rem;text-transform:uppercase;color:#6c7c77;margin-top:1.2rem}.job-actions{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;margin-top:1rem}.job-actions button,.job-actions a{min-height:3.3rem;border:0;border-radius:.6rem;background:#173f36;color:#fff;padding:.8rem;text-align:center;text-decoration:none}.cards{display:grid;gap:.7rem}.cards article{display:grid}.cards strong{font-size:1.7rem}.cards small{color:#6c7c77}@@media(min-width:700px){.cards{grid-template-columns:repeat(3,1fr)}}</style>
@code{[Parameter]public Guid? JobId{get;set;}private string section="";private bool loading=true;private List<DriverPortalJobDto>jobs=[];private DriverPortalJobDto?job;private DriverEarningsDto?earnings;private IReadOnlyList<DriverDocumentDto>documents=[];private List<DriverNotificationDto>notifications=[];private DriverPortalProfileDto?profile;private string Title=>JobId is not null?"Job details":section switch{"jobs"=>"My jobs","earnings"=>"Earnings","documents"=>"Documents","vehicle"=>"My vehicle","notifications"=>"Notifications","availability"=>"Availability","map"=>"Journey map",_=>"Profile"};protected override async Task OnParametersSetAsync(){loading=true;section=Navigation.ToBaseRelativePath(Navigation.Uri).Split('/').ElementAtOrDefault(1)??"profile";var c=Clients.CreateClient("LondonVIP.Api");if(JobId is not null)job=await c.GetFromJsonAsync<DriverPortalJobDto>($"api/driver/jobs/{JobId}");else if(section=="jobs")jobs=await c.GetFromJsonAsync<List<DriverPortalJobDto>>("api/driver/jobs")??[];else if(section=="earnings")earnings=await c.GetFromJsonAsync<DriverEarningsDto>("api/driver/earnings");else if(section=="documents")documents=await c.GetFromJsonAsync<List<DriverDocumentDto>>("api/driver/documents")??[];else if(section=="notifications")notifications=await c.GetFromJsonAsync<List<DriverNotificationDto>>("api/driver/notifications")??[];else profile=await c.GetFromJsonAsync<DriverPortalProfileDto>("api/driver/me");loading=false;}private static IEnumerable<(string Label,string Path)>Actions(BookingStatus s)=>s switch{BookingStatus.Assigned=>[("Accept","accept"),("Start navigation","enroute")],BookingStatus.DriverEnRoute=>[("Arrived","arrived")],BookingStatus.DriverArrived=>[("Passenger onboard","onboard"),("No show","noshow")],BookingStatus.PassengerOnBoard=>[("Complete journey","complete"),("Unable to complete","unable")],_=>[]};private async Task Run(string path){var c=Clients.CreateClient("LondonVIP.Api");HttpResponseMessage r;if(path is "noshow" or "unable")r=await c.PostAsJsonAsync($"api/driver/jobs/{JobId}/{path}",new DriverExceptionRequest(true,path=="noshow"?"Passenger not found":"Other",null));else r=await c.PostAsync($"api/driver/jobs/{JobId}/{path}",null);if(r.IsSuccessStatusCode)job=await c.GetFromJsonAsync<DriverPortalJobDto>($"api/driver/jobs/{JobId}");}}
