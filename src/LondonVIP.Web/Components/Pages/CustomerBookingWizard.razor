@page "/book"
@attribute [Authorize(Roles="Customer")]
@layout CustomerPortalLayout
@rendermode InteractiveServer
@using LondonVIP.Shared.Models
@using LondonVIP.Shared.Pricing
@using LondonVIP.Shared.CustomerPortal
@inject IHttpClientFactory Clients

<PageTitle>Book a journey | London VIP Cars</PageTitle>
<main class="wizard">
    <header><span>Customer booking</span><h1>Plan your journey</h1><div class="steps" role="progressbar" aria-label="Booking progress" aria-valuemin="1" aria-valuemax="5" aria-valuenow="@step">@for (var i = 1; i <= 5; i++) { <i class="@(i <= step ? "active" : null)" aria-current="@(i == step ? "step" : null)">@i</i> }</div><p class="progress-label">Step @step of 5 · @StepName</p></header>
    @if (step == 1)
    {
        <section><h2>Journey details</h2><label>Pickup<input @bind="request.PickupAddress" /></label><label>Destination<input @bind="request.Destination" /></label><div class="grid"><label>Date and time<input type="datetime-local" @bind="pickupLocal" /></label><label>Vehicle<select @bind="request.VehicleType">@foreach (var type in Enum.GetValues<VehicleType>()) { <option value="@type">@type</option> }</select></label><label>Passengers<input type="number" min="1" max="8" @bind="request.PassengerCount" /></label><label>Luggage<input type="number" min="0" max="20" @bind="request.LuggageCount" /></label></div><label><input type="checkbox" @bind="request.IsAirportPickup" /> Airport pickup</label><label><input type="checkbox" @bind="request.IsMeetAndGreet" /> Meet &amp; Greet</label><label>Flight number<input @bind="flightNumber" /></label><label>Promo code<input @bind="request.PromotionCode" /></label><button @onclick="PriceAsync">Get instant price</button></section>
    }
    else if (step == 2 && quote is not null)
    {
        <section><h2>Your quotation</h2><div class="journey-summary" aria-label="Journey summary"><span>@request.PickupAddress</span><b aria-hidden="true">→</b><span>@request.Destination</span></div>@if (!quote.IsConfigured) { <p role="alert">@quote.Message</p> } else { <dl><div><dt>Base fare</dt><dd>@quote.BaseFare.ToString("C")</dd></div>@foreach (var line in quote.Breakdown) { <div><dt>@line.Name</dt><dd>@line.Amount.ToString("C")</dd></div> }<div><dt>Total</dt><dd><strong>@quote.TotalFare.ToString("C")</strong></dd></div></dl><button @onclick="SaveQuoteAsync">Continue</button> }</section>
    }
    else if (step == 3)
    {
        <section><h2>Review</h2><p>@request.PickupAddress to @request.Destination</p><strong>@quote?.TotalFare.ToString("C")</strong><button @onclick="ConvertAsync">Confirm booking</button></section>
    }
    else if (step == 4)
    {
        <section><h2>Payment</h2><p>Secure online payment becomes available when a payment provider is configured. Your booking can currently be confirmed with payment pending.</p><button @onclick="() => step = 5">Continue</button></section>
    }
    else if (step == 5)
    {
        <section class="confirmation"><span class="confirmation-mark" aria-hidden="true">✓</span><h2>Booking confirmed</h2><p>Your reference is <strong>@bookingReference</strong>.</p><a href="/customer-portal">View my journeys</a></section>
    }
    @if (error is not null) { <p class="error" role="alert">@error</p> }
</main>
<style>
    .wizard{max-width:46rem;margin:2rem auto;padding:1rem;color:#173f36}.wizard h1{font:2.3rem Georgia,serif}.wizard header>span{color:#9c752d;text-transform:uppercase;font-size:.7rem}.steps{display:flex;gap:.5rem;margin:1rem 0 .35rem}.steps i{display:grid;place-items:center;width:2rem;height:2rem;border-radius:50%;background:#dce5e2;font-style:normal;transition:background-color .25s,transform .25s}.steps i.active{background:#173f36;color:#fff}.steps i[aria-current=step]{transform:scale(1.12);box-shadow:0 0 0 4px #dce5e2}.progress-label{margin:0 0 1rem;color:#587068;font-size:.8rem}.wizard section{display:grid;gap:1rem;background:#fff;border:1px solid #dce4e1;border-radius:1rem;padding:1.25rem;animation:wizard-in .35s ease-out}.wizard label{display:grid;gap:.3rem;font-size:.75rem}.wizard input,.wizard select{min-height:3rem;border:1px solid #b8c8c3;border-radius:.5rem;padding:.6rem}.wizard button,.wizard a{min-height:3.2rem;border:0;border-radius:.6rem;background:#173f36;color:#fff;padding:.8rem;text-align:center;text-decoration:none;cursor:pointer}.grid{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}.wizard dl div{display:flex;justify-content:space-between;padding:.5rem;border-bottom:1px solid #edf1ef}.journey-summary{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:.75rem;padding:1rem;border-radius:.75rem;background:#f2f6f4}.journey-summary span:last-child{text-align:right}.confirmation{text-align:center;justify-items:center;background:linear-gradient(145deg,#fff,#eef5f2)!important}.confirmation-mark{display:grid;place-items:center;width:4rem;height:4rem;border-radius:50%;background:#173f36;color:#fff;font-size:2rem}.error{color:#9a302c}@@keyframes wizard-in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}@@media(max-width:600px){.grid{grid-template-columns:1fr}.journey-summary{grid-template-columns:1fr}.journey-summary b{transform:rotate(90deg);justify-self:center}.journey-summary span:last-child{text-align:left}}@@media(prefers-reduced-motion:reduce){.wizard section{animation:none}.steps i{transition:none}}
</style>
@code {
    private int step = 1; private QuoteRequest request = new() { PassengerCount = 1 }; private QuoteResponse? quote; private DateTime pickupLocal = DateTime.Now.AddHours(3); private string? flightNumber; private string? error; private Guid quoteId; private string? bookingReference;
    private string StepName => step switch { 1 => "Journey", 2 => "Quotation", 3 => "Review", 4 => "Payment", _ => "Confirmation" };
    private HttpClient Client() => Clients.CreateClient("LondonVIP.Api");
    private async Task PriceAsync() { request.JourneyDateTime = new DateTimeOffset(pickupLocal); using var response = await Client().PostAsJsonAsync("api/quotes", request); if (!response.IsSuccessStatusCode) { error = "Please check the journey details."; return; } quote = await response.Content.ReadFromJsonAsync<QuoteResponse>(); step = 2; }
    private async Task SaveQuoteAsync() { using var response = await Client().PostAsJsonAsync("api/customer/quotes", new CustomerQuoteCreateRequest(request, new DateTimeOffset(pickupLocal), null, flightNumber, null)); if (!response.IsSuccessStatusCode) { error = "The quotation could not be saved."; return; } var result = await response.Content.ReadFromJsonAsync<Dictionary<string, System.Text.Json.JsonElement>>(); quoteId = result!["id"].GetGuid(); step = 3; }
    private async Task ConvertAsync() { using var response = await Client().PostAsync($"api/customer/quotes/{quoteId}/convert", null); if (!response.IsSuccessStatusCode) { error = "The booking could not be confirmed."; return; } var result = await response.Content.ReadFromJsonAsync<Dictionary<string, System.Text.Json.JsonElement>>(); bookingReference = result!["bookingReference"].GetString(); step = 4; }
}
