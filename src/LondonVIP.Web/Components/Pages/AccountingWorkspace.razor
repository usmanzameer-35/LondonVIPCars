@page "/erp/finance"
@page "/erp/bank"
@page "/erp/expenses"
@page "/erp/vat"
@page "/erp/journals"
@page "/erp/reports"
@page "/erp/budgets"
@page "/erp/suppliers"
@page "/erp/corporate-finance"
@page "/erp/driver-payments"
@page "/erp/credit-notes"
@page "/erp/recurring-invoices"
@page "/erp/supplier-payments"
@page "/erp/bank-reconciliation"
@page "/erp/fiscal-years"
@page "/erp/financial-statements"
@attribute [Authorize(Roles="Finance,Admin,SuperAdmin")]
@layout AdminLayout
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.Text.Json
@using LondonVIP.Shared.Accounting
@inject IHttpClientFactory Clients
@inject NavigationManager Navigation
<PageTitle>@Title | London VIP Cars ERP</PageTitle>
<main class="accounting"><header><div><span>Finance &amp; accounting</span><h1>@Title</h1><p>Tenant-scoped statutory, operational and management accounting.</p></div><button @onclick="Load">Refresh</button></header>
@if(Loading){<p class="state">Loading finance records…</p>}else if(Error is not null){<p class="state error" role="alert">@Error</p>}else{
<section class="finance-kpis"><article><span>Receivables</span><strong>@Data?.Receivables.ToString("C")</strong></article><article><span>Payables</span><strong>@Data?.Payables.ToString("C")</strong></article><article><span>Revenue</span><strong>@Data?.Revenue.ToString("C")</strong></article><article><span>Expenses</span><strong>@Data?.Expenses.ToString("C")</strong></article><article><span>VAT due</span><strong>@Data?.VatDue.ToString("C")</strong></article></section>
<nav aria-label="Finance modules">@foreach(var item in Modules){<a class="@(Path==item.Route?"active":null)" href="@item.Route">@item.Label</a>}</nav>
@if(IsAdmin){<section class="toolbar"><input aria-label="Search records" placeholder="Search" @bind="Search"/><button @onclick="SearchRecords">Search</button><button @onclick="NewRecord">New</button><button disabled="@(SelectedId is null)" @onclick='@(() => Bulk("archive"))'>Archive</button><button disabled="@(SelectedId is null)" @onclick='@(() => Bulk("restore"))'>Restore</button><label><input type="checkbox" @bind="IncludeArchived"/> Include archived</label></section>
@if(EditorOpen){<section class="editor"><h2>@(SelectedId is null?"Create record":"Edit record")</h2><p>Enter record fields as JSON. CompanyId and Id are controlled by the server.</p><textarea aria-label="Finance record JSON" @bind="Draft"></textarea><div><button @onclick="Save">Save</button><button class="secondary" @onclick="Cancel">Cancel</button></div>@if(Feedback is not null){<p role="status">@Feedback</p>}</section>}}
<section class="records"><header><h2>@Title records</h2><span>@Total records</span></header>@if(Rows.Count==0){<p class="state">No finance records exist for this tenant.</p>}@foreach(var row in Rows){var id=Id(row);<article class="@(SelectedId==id?"selected":null)" @onclick="()=>Select(row)"><pre>@JsonSerializer.Serialize(row,Pretty)</pre></article>}@if(IsAdmin&&Total>PageSize){<footer><button disabled="@(Page<=1)" @onclick="Previous">Previous</button><span>Page @Page</span><button disabled="@(Page*PageSize>=Total)" @onclick="Next">Next</button></footer>}</section>}
</main>
<style>.accounting{display:grid;gap:1rem;color:#173f36}.accounting>header,.records>header,.records>footer,.toolbar,.editor>div{display:flex;justify-content:space-between;align-items:center;gap:.7rem;flex-wrap:wrap}.accounting header>div>span{text-transform:uppercase;letter-spacing:.12em;color:#987334;font-size:.72rem}.accounting h1{font:2.2rem Georgia,serif;margin:.25rem 0}.accounting button{border:0;border-radius:.6rem;padding:.7rem 1rem;background:#173f36;color:#fff}.accounting button:disabled{opacity:.45}.secondary{background:#e7efec!important;color:#173f36!important}.finance-kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:.7rem}.finance-kpis article,.records,.toolbar,.editor{padding:1rem;border:1px solid #dce5e2;border-radius:.9rem;background:#fff}.finance-kpis span{display:block;color:#687b75;font-size:.75rem}.accounting nav{display:flex;gap:.35rem;overflow:auto}.accounting nav a{white-space:nowrap;padding:.55rem .8rem;border-radius:2rem;background:#e7efec;color:#173f36;text-decoration:none;font-size:.78rem}.accounting nav a.active{background:#173f36;color:#fff}.toolbar input{min-height:2.5rem;border:1px solid #b9cac5;border-radius:.5rem;padding:.5rem}.editor textarea{width:100%;min-height:18rem;font:13px/1.5 ui-monospace,monospace}.records article{border-top:1px solid #edf1ef;padding:.75rem;cursor:pointer}.records article.selected{background:#eef6f3;outline:2px solid #987334}.records pre{white-space:pre-wrap;font:12px/1.45 system-ui}.state{text-align:center;padding:2rem}.error{color:#9a302c}@@media(max-width:900px){.finance-kpis{grid-template-columns:repeat(2,1fr)}}@@media(max-width:540px){.finance-kpis{grid-template-columns:1fr}}</style>
@code{
 static readonly JsonSerializerOptions Pretty=new(){WriteIndented=true};
 static readonly(string Label,string Route,string Endpoint,string? Resource)[] Modules=[("Overview","/erp/finance","",null),("Accounts","/erp/accounts","","accounts"),("Invoices","/erp/invoices","",null),("Credit notes","/erp/credit-notes","","credit-notes"),("Recurring","/erp/recurring-invoices","","recurring-invoices"),("Payments","/erp/payments","",null),("Supplier payments","/erp/supplier-payments","","supplier-payments"),("Bank","/erp/bank","","bank-accounts"),("Reconciliation","/erp/bank-reconciliation","bank/transactions",null),("Expenses","/erp/expenses","","expenses"),("VAT","/erp/vat","","vat-returns"),("Journals","/erp/journals","","journals"),("Reports","/erp/reports","reports/profit-loss",null),("Statements","/erp/financial-statements","reports/balance-sheet",null),("Fiscal years","/erp/fiscal-years","","fiscal-years"),("Budgets","/erp/budgets","","budgets"),("Suppliers","/erp/suppliers","","suppliers"),("Corporate","/erp/corporate-finance","",null),("Driver payments","/erp/driver-payments","","driver-settlements")];
 FinanceDashboardDto? Data;List<JsonElement> Rows=[];bool Loading=true,EditorOpen,IncludeArchived;string? Error,Feedback;string Search="",Draft="{}";Guid? SelectedId;int Page=1,PageSize=25,Total;
 string Path=>"/"+Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/');(string Label,string Route,string Endpoint,string? Resource) Module=>Modules.FirstOrDefault(x=>x.Route==Path);string Title=>Module.Label??"Finance";bool IsAdmin=>Module.Resource is not null;
 protected override Task OnInitializedAsync()=>Load();
 async Task Load(){Loading=true;try{var c=Clients.CreateClient("LondonVIP.Api");Data=await c.GetFromJsonAsync<FinanceDashboardDto>("api/finance");Rows=[];Total=0;if(IsAdmin){var result=await c.GetFromJsonAsync<FinanceAdminPage>($"api/finance/admin/{Module.Resource}?search={Uri.EscapeDataString(Search)}&page={Page}&pageSize={PageSize}&includeArchived={IncludeArchived}");Rows=result?.Items.ToList()??[];Total=result?.Total??0;}else if(Module.Endpoint.Length>0){var endpoint=Module.Endpoint;var now=DateOnly.FromDateTime(DateTime.UtcNow);if(endpoint.Contains("reports/"))endpoint+=$"?from={now.AddMonths(-1):yyyy-MM-dd}&to={now:yyyy-MM-dd}";Rows=await LoadRows(c,endpoint);Total=Rows.Count;}Error=null;}catch(Exception ex){Error=$"Finance data could not be loaded: {ex.Message}";}finally{Loading=false;}}
 static async Task<List<JsonElement>> LoadRows(HttpClient c,string endpoint){using var response=await c.GetAsync($"api/finance/{endpoint}");response.EnsureSuccessStatusCode();using var doc=JsonDocument.Parse(await response.Content.ReadAsStringAsync());return doc.RootElement.ValueKind==JsonValueKind.Array?doc.RootElement.EnumerateArray().Select(x=>x.Clone()).ToList():[doc.RootElement.Clone()];}
 static Guid? Id(JsonElement row)=>row.TryGetProperty("id",out var id)&&id.TryGetGuid(out var value)?value:null;void Select(JsonElement row){SelectedId=Id(row);Draft=JsonSerializer.Serialize(row,Pretty);EditorOpen=true;}void NewRecord(){SelectedId=null;Draft="{}";EditorOpen=true;}void Cancel(){EditorOpen=false;SelectedId=null;}
 async Task Save(){try{using var doc=JsonDocument.Parse(Draft);var c=Clients.CreateClient("LondonVIP.Api");var response=SelectedId.HasValue?await c.PutAsJsonAsync($"api/finance/admin/{Module.Resource}/{SelectedId}",doc.RootElement):await c.PostAsJsonAsync($"api/finance/admin/{Module.Resource}",doc.RootElement);if(!response.IsSuccessStatusCode){Feedback=await response.Content.ReadAsStringAsync();return;}Cancel();await Load();}catch(JsonException){Feedback="Enter valid JSON.";}}
 async Task Bulk(string action){if(!SelectedId.HasValue)return;var response=await Clients.CreateClient("LondonVIP.Api").PostAsJsonAsync($"api/finance/admin/{Module.Resource}/bulk/{action}",new FinanceBulkRequest([SelectedId.Value]));if(response.IsSuccessStatusCode){Cancel();await Load();}else Feedback=await response.Content.ReadAsStringAsync();}async Task SearchRecords(){Page=1;await Load();}async Task Previous(){Page--;await Load();}async Task Next(){Page++;await Load();}
}
