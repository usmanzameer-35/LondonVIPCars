@page "/erp/fleet"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer
@using LondonVIP.Shared.Drivers
@using LondonVIP.Shared.Models
@using LondonVIP.Shared.Vehicles
@inject IHttpClientFactory HttpClientFactory
<PageTitle>Fleet | London VIP Cars ERP</PageTitle>
<div class="admin-page"><header><div><span>Fleet &amp; drivers</span><h1>Fleet</h1><p>Maintain company vehicles, capacity, assignment and compliance.</p></div><button class="primary" @onclick="New">+ Create vehicle</button></header>
@if(Loading){<div class="state">Loading fleet...</div>}else if(Error is not null){<div class="state error">@Error</div>}else{<section class="summary"><div><strong>@Items.Count(x=>x.IsActive)</strong><span>Active vehicles</span></div><div><strong>@Items.Count(x=>x.IsActive&&x.AssignedDriverId is null)</strong><span>Available</span></div><div><strong>@Items.Count(x=>x.AssignedDriverId is not null)</strong><span>Assigned</span></div><div><strong>@Items.Count(x=>x.ComplianceState is ComplianceState.ExpiringSoon or ComplianceState.Expired)</strong><span>Compliance attention</span></div></section><section class="filters"><label>Search<input type="search" @bind="Search" @bind:event="oninput" placeholder="Registration, make, model"/></label><label>Vehicle type<select @bind="Type"><option value="">All</option>@foreach(var x in Enum.GetValues<VehicleType>()){<option value="@x">@Display(x)</option>}</select></label><label>Active<select @bind="Active"><option value="all">All</option><option value="active">Active</option><option value="inactive">Inactive</option></select></label><label>Assignment<select @bind="Assignment"><option value="all">All</option><option value="assigned">Assigned</option><option value="unassigned">Unassigned</option></select></label></section>
@if(Filtered.Count==0){<div class="state"><h2>No vehicles found</h2><p>No real vehicle records match these filters.</p></div>}else{<div class="table-wrap"><table><thead><tr><th>Registration</th><th>Vehicle</th><th>Type</th><th>Capacity</th><th>Assigned driver</th><th>Compliance</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var v in Filtered){<tr><td data-label="Registration"><strong>@v.RegistrationNumber</strong></td><td data-label="Vehicle">@v.Make @v.Model</td><td data-label="Type">@Display(v.VehicleType)</td><td data-label="Capacity">@v.PassengerCapacity passengers<small>@v.LuggageCapacity luggage</small></td><td data-label="Assigned">@(v.AssignedDriverName??"Unassigned")</td><td data-label="Compliance"><span class="pill @v.ComplianceState.ToString().ToLowerInvariant()">@Display(v.ComplianceState)</span></td><td data-label="Status"><span class="pill @(v.IsActive?"valid":"muted")">@(v.IsActive?"Active":"Inactive")</span></td><td><button @onclick="()=>Edit(v.Id)">Edit</button><button @onclick="()=>Toggle(v)">@(v.IsActive?"Deactivate":"Activate")</button></td></tr>}</tbody></table></div>}}}</div>
@if(Editing){<div class="backdrop"><section class="editor"><header><h2>@(Id.HasValue?"Edit vehicle":"Create vehicle")</h2><button @onclick="Close">×</button></header>@if(Errors.Count>0){<div class="error"><ul>@foreach(var e in Errors){<li>@e</li>}</ul></div>}<EditForm Model="Form" OnSubmit="Save"><div class="form-grid"><label>Registration *<input @bind="Form.RegistrationNumber"/></label><label>Make *<input @bind="Form.Make"/></label><label>Model *<input @bind="Form.Model"/></label><label>Vehicle type<select @bind="Form.VehicleType">@foreach(var x in Enum.GetValues<VehicleType>()){<option value="@x">@Display(x)</option>}</select></label><label>Passengers<input type="number" min="1" max="50" @bind="Form.PassengerCapacity"/></label><label>Luggage<input type="number" min="0" max="100" @bind="Form.LuggageCapacity"/></label><label>Colour<input @bind="Form.Colour"/></label><label>Year<input type="number" min="1900" max="2100" @bind="Form.Year"/></label><label>MOT expiry<input type="date" @bind="Form.MOTExpiry"/></label><label>Insurance expiry<input type="date" @bind="Form.InsuranceExpiry"/></label><label>Private hire expiry<input type="date" @bind="Form.PrivateHireLicenceExpiry"/></label><label class="wide">Notes<textarea @bind="Form.Notes"></textarea></label><label class="check"><input type="checkbox" @bind="Form.IsActive"/> Active</label></div><footer><button type="button" @onclick="Close">Cancel</button><button class="primary" type="submit" disabled="@Saving">Save vehicle</button></footer></EditForm></section></div>}
@code{List<VehicleListItemDto> Items=[];VehicleUpdateDto Form=new();Guid? Id;bool Loading=true,Editing,Saving;string? Error;string Search="",Type="",Active="all",Assignment="all";List<string> Errors=[];List<VehicleListItemDto> Filtered=>Items.Where(x=>(string.IsNullOrWhiteSpace(Search)||$"{x.RegistrationNumber} {x.Make} {x.Model}".Contains(Search,StringComparison.OrdinalIgnoreCase))&&(Type==""||x.VehicleType.ToString()==Type)&&(Active=="all"||x.IsActive==(Active=="active"))&&(Assignment=="all"||x.AssignedDriverId.HasValue==(Assignment=="assigned"))).ToList();protected override Task OnInitializedAsync()=>Load();HttpClient Client()=>HttpClientFactory.CreateClient("LondonVIP.Api");async Task Load(){Loading=true;try{Items=await Client().GetFromJsonAsync<List<VehicleListItemDto>>("api/vehicles")??[];Error=null;}catch{Error="Fleet could not be loaded.";}finally{Loading=false;}}void New(){Id=null;Form=new(){IsActive=true,PassengerCapacity=1};Errors=[];Editing=true;}async Task Edit(Guid id){var x=await Client().GetFromJsonAsync<VehicleDetailDto>($"api/vehicles/{id}");if(x is null)return;Id=id;Form=new(){RegistrationNumber=x.RegistrationNumber,Make=x.Make,Model=x.Model,VehicleType=x.VehicleType,PassengerCapacity=x.PassengerCapacity,LuggageCapacity=x.LuggageCapacity,IsActive=x.IsActive,Colour=x.Colour,Year=x.Year,Notes=x.Notes,MOTExpiry=x.MOTExpiry,InsuranceExpiry=x.InsuranceExpiry,PrivateHireLicenceExpiry=x.PrivateHireLicenceExpiry};Errors=[];Editing=true;}async Task Save(){Saving=true;Errors=[];try{var r=Id.HasValue?await Client().PutAsJsonAsync($"api/vehicles/{Id}",Form):await Client().PostAsJsonAsync("api/vehicles",Form);if(r.IsSuccessStatusCode){Editing=false;await Load();}else await ReadErrors(r);}finally{Saving=false;}}async Task Toggle(VehicleListItemDto x){using var req=new HttpRequestMessage(HttpMethod.Patch,$"api/vehicles/{x.Id}/status"){Content=JsonContent.Create(new VehicleStatusUpdateDto{IsActive=!x.IsActive})};var r=await Client().SendAsync(req);if(!r.IsSuccessStatusCode)Error="Vehicle must be unassigned from active drivers before deactivation.";else await Load();}void Close()=>Editing=false;async Task ReadErrors(HttpResponseMessage r){try{var p=await r.Content.ReadFromJsonAsync<Problem>();Errors=p?.Errors.SelectMany(x=>x.Value).ToList()??["Vehicle could not be saved."];}catch{Errors=["Vehicle could not be saved."];}}static string Display<T>(T x)=>System.Text.RegularExpressions.Regex.Replace(x?.ToString()??"","([a-z])([A-Z])","$1 $2");sealed class Problem{public Dictionary<string,string[]> Errors{get;set;}=[];}}
