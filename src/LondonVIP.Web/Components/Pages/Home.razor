@page "/"

<PageTitle>London VIP Cars | Airport Transfers &amp; Private Hire</PageTitle>

<section class="hero">
    <div class="container-lvip hero-grid">
        <div class="hero-copy">
            <span class="eyebrow eyebrow-light">London airport transfers</span>
            <h1>Arrive calm.<br /><em>Travel considered.</em></h1>
            <p>Reliable, pre-booked journeys with professional drivers, thoughtfully selected vehicles and clear, upfront service.</p>
            <div class="hero-actions"><a class="button" href="#quote">Plan your journey</a><a class="text-link" href="#how-it-works">How it works <span aria-hidden="true">&rarr;</span></a></div>
            <div class="hero-proof" aria-label="Service highlights"><span><b>&#10003;</b> Flight monitoring ready</span><span><b>&#10003;</b> Professional drivers</span><span><b>&#10003;</b> Clear pricing</span></div>
        </div>
        <div class="hero-visual" aria-hidden="true"><div class="route-line"></div><div class="city-card"><small>Serving</small><strong>London</strong><span>and all major airports</span></div><div class="arrival-card"><span class="arrival-icon">&#9992;</span><div><small>Next stop</small><strong>Your destination</strong></div></div></div>
    </div>
</section>

<div id="quote" class="container-lvip quote-overlap"><QuoteWidget /></div>

<section id="airports" class="section">
    <div class="container-lvip">
        <div class="section-heading split-heading"><div><span class="eyebrow">Airport specialists</span><h2>Every London airport,<br />one considered service.</h2></div><p>Door-to-terminal and arrivals collections designed around your itinerary, luggage and group size.</p></div>
        <div class="airport-grid">
            @foreach (var airport in Airports)
            {
                <article class="airport-card"><span class="airport-code">@airport.Code</span><div><h3>@airport.Name</h3><p>Pre-booked pickup and drop-off</p></div><a href="#quote" aria-label="Get a quote for @airport.Name">&rarr;</a></article>
            }
        </div>
    </div>
</section>

<section id="fleet" class="section section-soft">
    <div class="container-lvip">
        <div class="section-heading centered"><span class="eyebrow">A vehicle for every journey</span><h2>Travel comfortably, whatever the plan.</h2><p>Choose the space that suits your passengers and luggage.</p></div>
        <div class="vehicle-grid">
            @foreach (var vehicle in Vehicles)
            {
                <article class="vehicle-card"><div class="vehicle-silhouette @vehicle.ClassName" aria-hidden="true"><span></span></div><div class="vehicle-copy"><h3>@vehicle.Name</h3><p>@vehicle.Description</p><div class="capacity"><span>&#9679; @vehicle.Passengers passengers</span><span>&#9632; @vehicle.Luggage luggage</span></div></div></article>
            }
        </div>
    </div>
</section>

<section id="why-us" class="section dark-section">
    <div class="container-lvip why-grid">
        <div class="section-heading"><span class="eyebrow eyebrow-light">Why London VIP Cars</span><h2>The details that make a journey feel effortless.</h2><p>From booking to drop-off, our service is built around reliability, clarity and care.</p><a class="button button-light" href="#quote">Request a quote</a></div>
        <div class="benefit-grid">@foreach (var benefit in Benefits) { <article><span class="number">@benefit.Number</span><h3>@benefit.Title</h3><p>@benefit.Text</p></article> }</div>
    </div>
</section>

<section id="how-it-works" class="section">
    <div class="container-lvip"><div class="section-heading centered"><span class="eyebrow">Simple by design</span><h2>From address to arrival in three steps.</h2></div><div class="steps"><article><span>01</span><h3>Tell us your journey</h3><p>Share your locations, time, passengers and preferred vehicle.</p></article><article><span>02</span><h3>Review your quote</h3><p>See a clear journey price before choosing to book.</p></article><article><span>03</span><h3>Meet your driver</h3><p>Receive journey details and travel with confidence.</p></article></div></div>
</section>

<section class="section flights-section">
    <div class="container-lvip"><div class="section-heading split-heading"><div><span class="eyebrow">Journey intelligence</span><h2>Flight-aware pickups,<br />coming soon.</h2></div><p>This preview shows how live arrival information will help coordinate airport collections once flight-data integration is enabled.</p></div><FlightCarousel Items="SampleFlights" /><p class="data-note"><span></span> Demonstration data only &mdash; live flight information is not yet connected.</p></div>
</section>

<section class="section trust-section">
    <div class="container-lvip trust-grid"><div><span class="eyebrow">Service you can trust</span><h2>London travel,<br />handled properly.</h2></div><blockquote><p>&ldquo;A dependable journey starts before the car arrives. We focus on clear communication, punctuality and a service that respects your time.&rdquo;</p><footer>London VIP Cars service promise</footer></blockquote><div class="trust-stats"><div><strong>4</strong><span>Major London airports</span></div><div><strong>24/7</strong><span>Pre-booking availability</span></div><div><strong>1</strong><span>Consistent standard</span></div></div></div>
</section>

@code {
    private static readonly (string Code, string Name)[] Airports = [("LHR", "Heathrow"), ("LGW", "Gatwick"), ("LTN", "Luton"), ("STN", "Stansted")];
    private static readonly (string Name, string Description, string ClassName, int Passengers, int Luggage)[] Vehicles = [
        ("Saloon", "Refined comfort for everyday journeys.", "saloon", 4, 2),
        ("Estate", "Extra luggage space without compromise.", "estate", 4, 4),
        ("MPV", "Flexible room for families and groups.", "mpv", 6, 4),
        ("Eight Seater", "Generous capacity for larger parties.", "eight", 8, 8)
    ];
    private static readonly (string Number, string Title, string Text)[] Benefits = [
        ("01", "Professional drivers", "Courteous, experienced and focused on a smooth journey."),
        ("02", "Thoughtful timing", "Airport collections designed around arrival times and practical waiting."),
        ("03", "The right vehicle", "Space matched to your party and luggage, not guesswork."),
        ("04", "Clear communication", "Straightforward journey details from quote to destination.")
    ];
    private static readonly IReadOnlyList<FlightDisplayItem> SampleFlights = [
        new("BA 281", "Los Angeles", "Heathrow T5", "14:20", "On time", "status-good"),
        new("EK 009", "Dubai", "Gatwick N", "15:05", "Expected 15:15", "status-watch"),
        new("U2 2242", "Geneva", "Luton", "15:40", "On time", "status-good")
    ];
}
