@page "/fleet"
@page "/fleet/{Slug}"
@using LondonVIP.Web.Components
<PageTitle>@(Selected?.Name??"Premium fleet") | London VIP Cars</PageTitle>
<HeadContent><meta name="description" content="Explore London VIP Cars vehicle categories, passenger capacity, luggage space and airport suitability."/><link rel="canonical" href="https://www.londonvipcars.co.uk/fleet"/><meta property="og:title" content="London VIP Cars premium fleet"/><meta property="og:description" content="Choose considered comfort for airport transfers, business travel and special occasions."/><meta property="og:type" content="website"/><meta property="og:image" content="/media/hero/hero-thumbnail.jpg"/><meta name="twitter:card" content="summary_large_image"/></HeadContent>
@if(Selected is not null){<main class="fleet-detail"><section class="fleet-detail-hero"><img src="@Selected.HeroImage" alt="@Selected.Name exterior" fetchpriority="high" onerror="this.hidden=true"/><div class="container-lvip"><span>@Selected.Category</span><h1>@Selected.Name</h1><p>@Selected.Description</p><a class="button" href="/#quote">Book this category</a></div></section><section class="container-lvip fleet-specs"><div><strong>@Selected.Passengers</strong><span>Passengers</span></div><div><strong>@Selected.Suitcases</strong><span>Suitcases</span></div><div><strong>@Selected.CarryOns</strong><span>Carry-ons</span></div><div><strong>@Selected.ExecutiveRating</strong><span>Executive rating</span></div></section><section class="container-lvip gallery" aria-label="Vehicle gallery">@foreach(var image in Selected.Gallery){<figure><img src="@image" alt="@Selected.Name @System.IO.Path.GetFileNameWithoutExtension(image).Replace('-',' ')" loading="lazy" decoding="async" onerror="this.closest('figure').classList.add('missing')"/><figcaption>@System.IO.Path.GetFileNameWithoutExtension(image).Replace('-',' ')</figcaption></figure>}</section></main>}
else{<main class="fleet-page"><header class="fleet-intro container-lvip"><span class="eyebrow">The London VIP Cars fleet</span><h1>Space to arrive<br/><em>at your best.</em></h1><p>Compare passenger capacity, luggage space and journey features across every vehicle category.</p></header><section class="container-lvip fleet-controls"><button class="@(Filter=="All"?"active":null)" @onclick="ShowAll">All vehicles</button><button @onclick="ShowAirport">Airport suitable</button><button @onclick="ShowWedding">Wedding suitable</button></section><section class="container-lvip premium-fleet-grid">@foreach(var vehicle in Filtered){<FleetVehicleCard Vehicle="vehicle" OnCompare="ToggleCompare"/>}</section>@if(Compared.Count>0){<aside class="compare-dock" aria-live="polite"><span>@Compared.Count vehicle@(Compared.Count==1?"":"s") selected</span><button @onclick="ClearComparison">Clear comparison</button></aside>}</main>}
@code{[Parameter]public string?Slug{get;set;}private string Filter="All";private readonly List<FleetVehicleViewModel>Compared=[];private FleetVehicleViewModel?Selected=>PublicFleetCatalog.All.FirstOrDefault(x=>x.Slug.Equals(Slug,StringComparison.OrdinalIgnoreCase));private IEnumerable<FleetVehicleViewModel>Filtered=>PublicFleetCatalog.All.Where(x=>Filter=="All"||Filter=="Airport"&&x.AirportSuitable||Filter=="Wedding"&&x.WeddingSuitable);private void ShowAll()=>Filter="All";private void ShowAirport()=>Filter="Airport";private void ShowWedding()=>Filter="Wedding";private void ClearComparison()=>Compared.Clear();private void ToggleCompare(FleetVehicleViewModel v){if(Compared.Contains(v))Compared.Remove(v);else if(Compared.Count<3)Compared.Add(v);}}
