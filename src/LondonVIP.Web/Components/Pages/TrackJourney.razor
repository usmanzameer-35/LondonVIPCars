@page "/track/{Token}"
@layout MainLayout
@rendermode InteractiveServer
@using LondonVIP.Shared.Maps
@inject IHttpClientFactory HttpClientFactory
<PageTitle>Track My Driver | London VIP Cars</PageTitle>
<main class="tracking"><h1>Track my driver</h1>@if(loading){<p>Loading your journey…</p>}else if(data is null){<p role="alert">This tracking link is invalid or has expired.</p>}else{<section><span>@data.Status</span><h2>@data.BookingReference</h2><p>@(data.DriverName??"Your driver will appear once assigned")</p><p>@(data.Vehicle??"Vehicle pending") · @(data.Registration??"—")</p>@if(data.EstimatedArrival is not null){<strong>Estimated arrival @data.EstimatedArrival.Value.LocalDateTime.ToString("HH:mm")</strong>}<div class="journey-progress"><i></i></div><small>Location updates automatically when the driver publishes a new position.</small></section>}</main>
<style>.tracking{max-width:42rem;margin:4rem auto;padding:1rem}.tracking h1{font:2.5rem Georgia,serif;color:#173f36}.tracking section{background:#f7f4ec;border:1px solid #d8e1dd;border-radius:1rem;padding:1.5rem}.tracking section>span{color:#9b762e;text-transform:uppercase}.journey-progress{height:.5rem;background:#dbe4e1;border-radius:1rem;margin:1.5rem 0}.journey-progress i{display:block;width:55%;height:100%;background:#b68a35;border-radius:1rem}</style>
@code { [Parameter] public string Token { get; set; } = ""; private CustomerTrackingDto? data; private bool loading=true; protected override async Task OnInitializedAsync(){try{data=await HttpClientFactory.CreateClient("Api").GetFromJsonAsync<CustomerTrackingDto>($"api/tracking/{Uri.EscapeDataString(Token)}");}catch(HttpRequestException){data=null;}finally{loading=false;}} }
