@page "/erp/quotes"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer
@using LondonVIP.Shared.Quotations
@using LondonVIP.Shared.Pricing
@using LondonVIP.Shared.Bookings
@using LondonVIP.Shared.Models
@inject IHttpClientFactory HttpClientFactory
<PageTitle>Quotes | London VIP Cars ERP</PageTitle>
<div class="quotes-page"><header><div><span>Operations</span><h1>Quotations</h1><p>Database-priced customer and corporate quotations.</p></div><button @onclick="NewQuote">+ Create quote</button></header>
<section class="filters"><input type="search" placeholder="Search reference or customer" @bind="Search" @bind:event="oninput"/><select @bind="Status"><option value="">All statuses</option>@foreach(var status in Enum.GetValues<QuoteStatus>()){<option value="@status">@status</option>}</select><button @onclick="LoadAsync">Refresh</button></section>
@if(Loading){<div class="state">Loading quotations...</div>}else if(Error is not null){<div class="state error">@Error</div>}else{<div class="quote-grid">@foreach(var quote in Filtered){<article><div class="quote-head"><div><strong>@quote.QuoteReference</strong><span>@quote.CustomerName</span></div><span class="pill @quote.Status.ToString().ToLowerInvariant()">@quote.Status</span></div><p>@quote.PickupDateTime.LocalDateTime.ToString("dd MMM yyyy, HH:mm") · @quote.VehicleType</p><div class="quote-foot"><strong>@quote.TotalFare.ToString("C",Uk)</strong><span>Expires @quote.ExpiresAt.LocalDateTime.ToString("dd MMM, HH:mm")</span><button @onclick="()=>OpenAsync(quote.Id)">View</button></div></article>}</div>}</div>
@if(Selected is not null){<div class="backdrop"><section class="panel"><header><div><span>Quote detail</span><h2>@Selected.QuoteReference</h2></div><button @onclick="Close">×</button></header><dl><div><dt>Customer</dt><dd>@Selected.CustomerName</dd></div><div><dt>Status</dt><dd>@Selected.Status</dd></div><div><dt>Route</dt><dd>@Selected.PickupAddress → @Selected.Destination</dd></div><div><dt>Fare</dt><dd>@Selected.TotalFare.ToString("C",Uk)</dd></div><div><dt>Pricing</dt><dd>@Selected.PricingBreakdown.Count configured components</dd></div></dl><footer>@if(Selected.Status==QuoteStatus.Draft){<button @onclick="EditSelected">Edit draft</button>}<button @onclick="DuplicateAsync">Duplicate</button>@if(Selected.Status==QuoteStatus.Active){<button @onclick="ConvertAsync">Convert to booking</button><button @onclick="CancelAsync">Cancel</button>}@if(Selected.ConvertedBookingId.HasValue){<a href="/erp/bookings">View booking</a>}</footer></section></div>}
@if(Editing){<div class="backdrop"><section class="panel editor"><header><div><span>@(EditingId.HasValue?"Edit draft":"New quotation")</span><h2>Journey and pricing</h2></div><button @onclick="CancelEdit">×</button></header><EditForm Model="Editor" OnSubmit="SaveAsync"><div class="form"><label><span>Customer</span><select @bind="Editor.CustomerId"><option value="">Select customer</option>@foreach(var item in Lookups.Customers){<option value="@item.Id">@item.Label</option>}</select></label><label><span>Corporate account</span><select @bind="Editor.CorporateAccountId"><option value="">None</option>@foreach(var item in Lookups.CorporateAccounts){<option value="@item.Id">@item.Label</option>}</select></label><label><span>Pickup</span><input @bind="Editor.Pricing.PickupAddress"/></label><label><span>Destination</span><input @bind="Editor.Pricing.Destination"/></label><label><span>Pickup time</span><input type="datetime-local" @bind="Editor.PickupDateTime"/></label><label><span>Vehicle</span><select @bind="Editor.Pricing.VehicleType">@foreach(var vehicle in Enum.GetValues<VehicleType>()){<option value="@vehicle">@vehicle</option>}</select></label><label><span>Passengers</span><input type="number" min="1" max="8" @bind="Editor.Pricing.PassengerCount"/></label><label><span>Luggage</span><input type="number" min="0" @bind="Editor.Pricing.LuggageCount"/></label><label><span>Airport</span><select @bind="Editor.Pricing.AirportId"><option value="">None</option>@foreach(var item in Lookups.Airports){<option value="@item.Id">@item.Code — @item.Name</option>}</select></label><label><span>Flight</span><input @bind="Editor.FlightNumber"/></label><label><span>Waiting estimate</span><input type="number" @bind="Editor.Pricing.WaitingMinutes"/></label><label><span>Parking estimate</span><input type="number" step="0.01" @bind="Editor.Pricing.ParkingCharges"/></label><label><span>Promotion code</span><input @bind="Editor.Pricing.PromotionCode"/></label><label><span>Expiry</span><input type="datetime-local" @bind="Editor.ExpiresAt"/></label><label class="wide"><span>Notes</span><textarea @bind="Editor.Notes"></textarea></label><label><input type="checkbox" @bind="Editor.Pricing.IsAirportPickup"/> Airport pickup</label><label><input type="checkbox" @bind="Editor.Pricing.IsMeetAndGreet"/> Meet &amp; greet</label><label><input type="checkbox" @bind="Editor.Pricing.IsCorporateCustomer"/> Corporate pricing</label><label><input type="checkbox" @bind="Editor.SaveAsDraft"/> Save as draft</label></div>@if(SaveError is not null){<p class="error">@SaveError</p>}<footer><button type="button" @onclick="CancelEdit">Cancel</button><button type="submit">Save quotation</button></footer></EditForm></section></div>}
@code{private static readonly System.Globalization.CultureInfo Uk=System.Globalization.CultureInfo.GetCultureInfo("en-GB");private List<QuotationListItemDto> Items=[];private BookingLookupsDto Lookups=new();private QuotationDetailDto? Selected;private QuotationUpdateDto Editor=new();private Guid? EditingId;private string Search="";private string Status="";private bool Loading=true;private bool Editing;private string? Error;private string? SaveError;private List<QuotationListItemDto> Filtered=>Items.Where(x=>(string.IsNullOrWhiteSpace(Search)||$"{x.QuoteReference} {x.CustomerName}".Contains(Search,StringComparison.OrdinalIgnoreCase))&&(string.IsNullOrEmpty(Status)||x.Status.ToString()==Status)).ToList();protected override Task OnInitializedAsync()=>LoadAsync();private async Task LoadAsync(){Loading=true;try{var c=Client();Items=await c.GetFromJsonAsync<List<QuotationListItemDto>>("api/quotations")??[];Lookups=await c.GetFromJsonAsync<BookingLookupsDto>("api/bookings/lookups")??new();}catch{Error="Quotations could not be loaded.";}finally{Loading=false;}}private void NewQuote(){EditingId=null;Editor=new(){PickupDateTime=DateTimeOffset.Now.AddDays(1),ExpiresAt=DateTimeOffset.Now.AddHours(48),Pricing=new(){PassengerCount=1}};Editing=true;}private async Task OpenAsync(Guid id)=>Selected=await Client().GetFromJsonAsync<QuotationDetailDto>($"api/quotations/{id}");private void EditSelected(){if(Selected is null)return;EditingId=Selected.Id;Editor=new(){CustomerId=Selected.CustomerId,CorporateAccountId=Selected.CorporateAccountId,PickupDateTime=Selected.PickupDateTime,FlightNumber=Selected.FlightNumber,Notes=Selected.Notes,ExpiresAt=Selected.ExpiresAt,SaveAsDraft=true,Pricing=new(){PickupAddress=Selected.PickupAddress,Destination=Selected.Destination,PassengerCount=Selected.PassengerCount,LuggageCount=Selected.LuggageCount,VehicleType=Selected.VehicleType,AirportId=Selected.AirportId,IsAirportPickup=Selected.IsAirportPickup,IsMeetAndGreet=Selected.IsMeetAndGreet,JourneyDateTime=Selected.PickupDateTime}};Selected=null;Editing=true;}private async Task SaveAsync(){Editor.Pricing.JourneyDateTime=Editor.PickupDateTime;using var r=EditingId.HasValue?await Client().PutAsJsonAsync($"api/quotations/{EditingId}",Editor):await Client().PostAsJsonAsync("api/quotations",Editor);if(r.IsSuccessStatusCode){Editing=false;await LoadAsync();}else SaveError="The quotation could not be saved. Check pricing and journey details.";}private async Task DuplicateAsync(){if(Selected is null)return;await Client().PostAsync($"api/quotations/{Selected.Id}/duplicate",null);Selected=null;await LoadAsync();}private async Task ConvertAsync(){if(Selected is null)return;await Client().PostAsync($"api/quotations/{Selected.Id}/convert",null);Selected=null;await LoadAsync();}private async Task CancelAsync(){if(Selected is null)return;await Client().PostAsync($"api/quotations/{Selected.Id}/cancel",null);Selected=null;await LoadAsync();}private void Close()=>Selected=null;private void CancelEdit()=>Editing=false;private HttpClient Client()=>HttpClientFactory.CreateClient("LondonVIP.Api");}
