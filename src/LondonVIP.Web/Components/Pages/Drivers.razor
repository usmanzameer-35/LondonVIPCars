@page "/erp/drivers"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer
@using LondonVIP.Shared.Drivers
@using LondonVIP.Shared.Models
@using LondonVIP.Shared.Vehicles
@inject IHttpClientFactory HttpClientFactory
<PageTitle>Drivers | London VIP Cars ERP</PageTitle>
<div class="admin-page">
 <header><div><span>Fleet &amp; drivers</span><h1>Drivers</h1><p>Manage operational availability, compliance and vehicle assignments.</p></div><button class="primary" @onclick="New">+ Create driver</button></header>
 @if(Loading){<div class="state">Loading drivers...</div>}else if(Error is not null){<div class="state error">@Error</div>}else{
 <section class="summary"><div><strong>@Items.Count(x=>x.IsActive)</strong><span>Active drivers</span></div><div><strong>@Items.Count(x=>x.IsActive&&x.AvailabilityStatus==DriverAvailabilityStatus.Available)</strong><span>Available</span></div><div><strong>@Items.Count(x=>x.IsActive&&x.AvailabilityStatus==DriverAvailabilityStatus.Busy)</strong><span>Busy</span></div><div><strong>@Items.Count(x=>x.VehicleId is null)</strong><span>Without vehicles</span></div></section>
 <section class="filters"><label>Search<input type="search" @bind="Search" @bind:event="oninput" placeholder="Name, phone, email"/></label><label>Active<select @bind="Active"><option value="all">All</option><option value="active">Active</option><option value="inactive">Inactive</option></select></label><label>Availability<select @bind="Availability"><option value="">All</option>@foreach(var x in Enum.GetValues<DriverAvailabilityStatus>()){<option value="@x">@Display(x)</option>}</select></label><label>Vehicle<select @bind="Assignment"><option value="all">All</option><option value="assigned">Assigned</option><option value="unassigned">Unassigned</option></select></label></section>
 @if(Filtered.Count==0){<div class="state"><h2>No drivers found</h2><p>No real driver records match these filters.</p></div>}else{<div class="table-wrap"><table><thead><tr><th>Driver</th><th>Contact</th><th>Availability</th><th>Vehicle</th><th>Compliance</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var d in Filtered){<tr><td data-label="Driver"><strong>@d.FirstName @d.LastName</strong><small>@d.DriverNumber</small></td><td data-label="Contact">@d.Phone<small>@d.Email</small></td><td data-label="Availability"><select value="@d.AvailabilityStatus" @onchange="e=>AvailabilityChanged(d,e)">@foreach(var x in Enum.GetValues<DriverAvailabilityStatus>()){<option value="@x">@Display(x)</option>}</select></td><td data-label="Vehicle">@(d.RegistrationNumber??"Unassigned")<small>@d.VehicleDisplay</small></td><td data-label="Compliance"><span class="pill @d.ComplianceState.ToString().ToLowerInvariant()">@Display(d.ComplianceState)</span></td><td data-label="Status"><span class="pill @(d.IsActive?"valid":"muted")">@(d.IsActive?"Active":"Inactive")</span></td><td><button @onclick="()=>Edit(d.Id)">Edit</button><button @onclick="()=>Toggle(d)">@(d.IsActive?"Deactivate":"Activate")</button></td></tr>}</tbody></table></div>}}
</div>
@if(Editing){<div class="backdrop"><section class="editor"><header><h2>@(Id.HasValue?"Edit driver":"Create driver")</h2><button @onclick="Close">×</button></header>@if(Errors.Count>0){<div class="error"><ul>@foreach(var e in Errors){<li>@e</li>}</ul></div>}<EditForm Model="Form" OnSubmit="Save"><div class="form-grid"><label>First name *<input @bind="Form.FirstName"/></label><label>Last name *<input @bind="Form.LastName"/></label><label>Phone<input @bind="Form.Phone"/></label><label>Email<input type="email" @bind="Form.Email"/></label><label>Driver number<input @bind="Form.DriverNumber"/></label><label>Availability<select @bind="Form.AvailabilityStatus">@foreach(var x in Enum.GetValues<DriverAvailabilityStatus>()){<option value="@x">@Display(x)</option>}</select></label><label>Vehicle<select @bind="Form.VehicleId"><option value="">Unassigned</option>@foreach(var v in Vehicles.Where(x=>x.IsActive&&(x.AssignedDriverId is null||x.AssignedDriverId==Id))){<option value="@v.Id">@v.RegistrationNumber — @v.Make @v.Model</option>}</select></label><label>Driving licence<input @bind="Form.DrivingLicenceNumber"/></label><label>Driving licence expiry<input type="date" @bind="Form.DrivingLicenceExpiry"/></label><label>Private hire licence<input @bind="Form.PrivateHireLicenceNumber"/></label><label>Private hire expiry<input type="date" @bind="Form.PrivateHireLicenceExpiry"/></label><label>DBS expiry<input type="date" @bind="Form.DBSExpiry"/></label><label>Medical expiry<input type="date" @bind="Form.MedicalExpiry"/></label><label class="wide">Notes<textarea @bind="Form.Notes"></textarea></label><label class="check"><input type="checkbox" @bind="Form.IsActive"/> Active</label></div><footer><button type="button" @onclick="Close">Cancel</button><button class="primary" type="submit" disabled="@Saving">Save driver</button></footer></EditForm></section></div>}
@code{
 List<DriverListItemDto> Items=[];List<VehicleListItemDto> Vehicles=[];DriverUpdateDto Form=new();Guid? Id;bool Loading=true,Editing,Saving;string? Error;string Search="",Active="all",Availability="",Assignment="all";List<string> Errors=[];
 List<DriverListItemDto> Filtered=>Items.Where(x=>(string.IsNullOrWhiteSpace(Search)||$"{x.FirstName} {x.LastName} {x.Email} {x.Phone}".Contains(Search,StringComparison.OrdinalIgnoreCase))&&(Active=="all"||x.IsActive==(Active=="active"))&&(Availability==""||x.AvailabilityStatus.ToString()==Availability)&&(Assignment=="all"||x.VehicleId.HasValue==(Assignment=="assigned"))).ToList();
 protected override Task OnInitializedAsync()=>Load();HttpClient Client()=>HttpClientFactory.CreateClient("LondonVIP.Api");async Task Load(){Loading=true;try{var a=Client().GetFromJsonAsync<List<DriverListItemDto>>("api/drivers");var b=Client().GetFromJsonAsync<List<VehicleListItemDto>>("api/vehicles");await Task.WhenAll(a,b);Items=a.Result??[];Vehicles=b.Result??[];Error=null;}catch{Error="Drivers could not be loaded.";}finally{Loading=false;}}
 void New(){Id=null;Form=new(){IsActive=true,AvailabilityStatus=DriverAvailabilityStatus.Offline};Errors=[];Editing=true;}async Task Edit(Guid id){var x=await Client().GetFromJsonAsync<DriverDetailDto>($"api/drivers/{id}");if(x is null)return;Id=id;Form=new(){FirstName=x.FirstName,LastName=x.LastName,Phone=x.Phone,Email=x.Email,DriverNumber=x.DriverNumber,Notes=x.Notes,DrivingLicenceNumber=x.DrivingLicenceNumber,DrivingLicenceExpiry=x.DrivingLicenceExpiry,PrivateHireLicenceNumber=x.PrivateHireLicenceNumber,PrivateHireLicenceExpiry=x.PrivateHireLicenceExpiry,DBSExpiry=x.DBSExpiry,MedicalExpiry=x.MedicalExpiry,AvailabilityStatus=x.AvailabilityStatus,VehicleId=x.VehicleId,IsActive=x.IsActive};Errors=[];Editing=true;}
 async Task Save(){Saving=true;Errors=[];try{var response=Id.HasValue?await Client().PutAsJsonAsync($"api/drivers/{Id}",Form):await Client().PostAsJsonAsync("api/drivers",Form);if(response.IsSuccessStatusCode){Editing=false;await Load();}else await ReadErrors(response);}finally{Saving=false;}}async Task Toggle(DriverListItemDto x){using var req=new HttpRequestMessage(HttpMethod.Patch,$"api/drivers/{x.Id}/status"){Content=JsonContent.Create(new DriverStatusUpdateDto{IsActive=!x.IsActive})};await Client().SendAsync(req);await Load();}async Task AvailabilityChanged(DriverListItemDto x,ChangeEventArgs e){if(!Enum.TryParse<DriverAvailabilityStatus>(e.Value?.ToString(),out var status))return;using var req=new HttpRequestMessage(HttpMethod.Patch,$"api/drivers/{x.Id}/availability"){Content=JsonContent.Create(new DriverAvailabilityUpdateDto{AvailabilityStatus=status})};await Client().SendAsync(req);await Load();}void Close()=>Editing=false;async Task ReadErrors(HttpResponseMessage r){try{var p=await r.Content.ReadFromJsonAsync<Problem>();Errors=p?.Errors.SelectMany(x=>x.Value).ToList()??["Driver could not be saved."];}catch{Errors=["Driver could not be saved."];}}static string Display<T>(T x)=>System.Text.RegularExpressions.Regex.Replace(x?.ToString()??"","([a-z])([A-Z])","$1 $2");sealed class Problem{public Dictionary<string,string[]> Errors{get;set;}=[];}
}
