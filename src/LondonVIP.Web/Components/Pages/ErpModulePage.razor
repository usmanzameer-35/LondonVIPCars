@layout AdminLayout
@using LondonVIP.Web.Components.Erp
@inject NavigationManager Navigation

<PageTitle>@Module.Title | London VIP Cars ERP</PageTitle>
<ModulePlaceholder Module="Module" />

@code {
    private ErpModuleDefinition Module => ErpModuleCatalog.Find("/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/'))
        ?? throw new InvalidOperationException("The ERP module route is not registered.");
}
