@page "/erp/dispatch"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer
@using LondonVIP.Shared.Dispatch
@using LondonVIP.Shared.Models
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Dispatch | London VIP Cars ERP</PageTitle>

<div class="dispatch-page">
    <header class="dispatch-heading">
        <div><span>Operations</span><h1>Dispatch Centre</h1><p>Live bookings, drivers, timeline and operational alerts.</p></div>
        <button type="button" class="refresh-button" disabled="@Loading" @onclick="LoadAsync">Refresh board</button>
    </header>

    @if (Loading)
    {
        <div class="dispatch-state">Loading live dispatch data...</div>
    }
    else if (!string.IsNullOrEmpty(Error))
    {
        <div class="dispatch-state error" role="alert">@Error</div>
    }
    else
    {
        <nav class="dispatch-tabs"><a href="#driver-board">Driver Board</a><a href="#operations-timeline">Operations Timeline</a><a href="#alerts">Alerts</a><span>Map · Coming Soon</span></nav>
        <section class="dispatch-tools"><input type="search" placeholder="Search booking, customer, driver, vehicle, invoice or quote" @bind="SearchTerm"/><button @onclick="SearchAsync">Search</button><select @bind="StatusFilter"><option value="">All statuses</option>@foreach(var status in Enum.GetValues<BookingStatus>()){<option value="@status">@Display(status)</option>}</select></section>
        @if(SearchResults.Count>0){<section class="search-results">@foreach(var result in SearchResults){<a href="@result.Url"><b>@result.Type · @result.Reference</b><span>@result.Title — @result.Subtitle</span></a>}</section>}
        <section class="dispatch-summary" aria-label="Dispatch summary">
            @if(Centre is not null){@foreach(var metric in Metrics(Centre.Kpis)){<div><strong>@metric.Value</strong><span>@metric.Label</span></div>}}
        </section>

        <section class="upcoming-section">
            <div class="section-title"><div><span>Operational window</span><h2>Upcoming jobs</h2></div><small>Next 2 hours · real booking data</small></div>
            @if (Upcoming.Count == 0) { <p class="empty-line">No operational jobs are due in the next two hours.</p> }
            else { <div class="upcoming-list">@foreach (var job in Upcoming) { <a href="#dispatch-@job.BookingId"><strong>@job.PickupDateTime.LocalDateTime.ToString("HH:mm")</strong><span>@job.BookingReference · @job.CustomerName</span><em>@TimingLabel(job)</em></a> }</div> }
        </section>

        <section class="dispatch-board" aria-label="Operational dispatch board">
            @BoardColumn("Unassigned", "Confirmed jobs awaiting a driver", Unassigned, "unassigned")
            @BoardColumn("Assigned", "Driver confirmed", Assigned, "assigned")
            @BoardColumn("En Route", "Driver travelling to pickup", EnRoute, "active")
            @BoardColumn("Passenger On Board", "Journey in progress", PassengerOnBoard, "active")
        </section>
        <section class="centre-panels">
         <article class="centre-panel" id="operations-timeline"><header><h2>Operations Timeline</h2></header>@if(Centre?.Timeline.Count is 0){<p class="empty-line">No dispatch activity recorded.</p>}@foreach(var item in Centre?.Timeline??[]){<div class="timeline-row"><time>@item.Timestamp.LocalDateTime.ToString("HH:mm")</time><div><strong>@DisplayText(item.Action)</strong><span>@item.Description</span></div></div>}</article>
         <article class="centre-panel" id="driver-board"><header><h2>Driver Board</h2></header>@if(Centre?.Drivers.Count is 0){<p class="empty-line">No drivers found.</p>}@foreach(var driver in Centre?.Drivers??[]){<div class="driver-row"><span class="avatar">@driver.Name[0]</span><div><strong>@driver.Name</strong><small>@(driver.Vehicle??"No vehicle") · @driver.Registration</small><small>@(driver.CurrentBookingReference??"No current booking") · @driver.TodaysJobs jobs today</small></div><b class="driver-status">@driver.CalculatedStatus</b><div class="contact-actions"><a href="tel:@driver.Phone">Call</a><span>SMS</span><span>WhatsApp</span></div></div>}</article>
         <article class="centre-panel" id="alerts"><header><h2>Operational Alerts</h2></header>@if(Centre?.Alerts.Count is 0){<p class="empty-line">No outstanding alerts.</p>}@foreach(var alert in Centre?.Alerts??[]){<div class="alert-row @alert.Severity.ToLowerInvariant()"><strong>@alert.Title</strong><span>@alert.Detail</span></div>}</article>
        </section>
    }
</div>
<style>.dispatch-tabs,.dispatch-tools{display:flex;gap:.55rem;align-items:center;overflow:auto}.dispatch-tabs a,.dispatch-tabs span{white-space:nowrap;border:1px solid #d9e3df;border-radius:2rem;background:#fff;color:#315f53;padding:.45rem .7rem;font-size:.68rem;text-decoration:none}.dispatch-tools{display:grid;grid-template-columns:1fr auto minmax(10rem,auto);background:#fff;border:1px solid #dfe7e4;border-radius:.8rem;padding:.7rem}.dispatch-tools input,.dispatch-tools select{min-width:0;border:1px solid #bdcac6;border-radius:.45rem;padding:.65rem}.search-results,.centre-panel{background:#fff;border:1px solid #dfe7e4;border-radius:.8rem;padding:.7rem}.search-results a{display:flex;justify-content:space-between;gap:1rem;color:#274d44;padding:.45rem;text-decoration:none}.centre-panels{display:grid;gap:1rem}.centre-panel h2{font:1.15rem Georgia,serif}.timeline-row,.driver-row,.alert-row{display:flex;gap:.65rem;align-items:center;border-top:1px solid #edf1f0;padding:.7rem 0}.timeline-row div,.driver-row>div{min-width:0;flex:1}.timeline-row strong,.timeline-row span,.driver-row strong,.driver-row small,.alert-row strong,.alert-row span{display:block}.timeline-row span,.driver-row small,.alert-row span{color:#71817d;font-size:.65rem}.avatar{width:2rem;height:2rem;display:grid;place-items:center;border-radius:50%;background:#dce9e4}.contact-actions{display:flex!important;gap:.3rem!important;flex:0!important}.contact-actions a,.contact-actions span{border:1px solid #d9e3df;border-radius:.35rem;padding:.3rem;font-size:.58rem}.alert-row{display:block;border-left:3px solid #c79536;padding-left:.65rem}.alert-row.critical{border-left-color:#b8493e}@@media(min-width:800px){.dispatch-summary{grid-template-columns:repeat(5,minmax(0,1fr))}.centre-panels{grid-template-columns:repeat(3,minmax(0,1fr))}}@@media(max-width:600px){.dispatch-tools{grid-template-columns:1fr}}</style>

@code {
    private static readonly System.Globalization.CultureInfo UkCulture = System.Globalization.CultureInfo.GetCultureInfo("en-GB");
    private List<DispatchBoardItemDto> Jobs { get; set; } = [];
    private List<DriverAvailabilityDto> Drivers { get; set; } = [];
    private DispatchDashboardDto? Centre { get; set; }
    private List<DispatchSearchResultDto> SearchResults { get; set; } = [];
    private string SearchTerm { get; set; } = "";
    private string StatusFilter { get; set; } = "";
    private Dictionary<Guid, Guid> DriverSelections { get; } = [];
    private bool Loading { get; set; } = true;
    private string? Error { get; set; }
    private Guid? BusyBooking { get; set; }
    private IEnumerable<DispatchBoardItemDto> VisibleJobs => Enum.TryParse<BookingStatus>(StatusFilter,out var status)?Jobs.Where(x=>x.Status==status):Jobs;
    private List<DispatchBoardItemDto> Unassigned => VisibleJobs.Where(x => x.Status == BookingStatus.Confirmed && x.DriverId is null).ToList();
    private List<DispatchBoardItemDto> Assigned => VisibleJobs.Where(x => x.Status == BookingStatus.Assigned).ToList();
    private List<DispatchBoardItemDto> EnRoute => VisibleJobs.Where(x => x.Status == BookingStatus.DriverEnRoute).ToList();
    private List<DispatchBoardItemDto> PassengerOnBoard => VisibleJobs.Where(x => x.Status == BookingStatus.PassengerOnBoard).ToList();
    private int ActiveCount => EnRoute.Count + PassengerOnBoard.Count;
    private List<DispatchBoardItemDto> Upcoming { get { var now = DateTimeOffset.Now; return Jobs.Where(x => x.PickupDateTime >= now && x.PickupDateTime <= now.AddHours(2)).OrderBy(x => x.PickupDateTime).ToList(); } }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        Loading = true; Error = null;
        try
        {
            var boardTask = Client().GetFromJsonAsync<List<DispatchBoardItemDto>>("api/dispatch");
            var driversTask = Client().GetFromJsonAsync<List<DriverAvailabilityDto>>("api/dispatch/drivers");
            var centreTask = Client().GetFromJsonAsync<DispatchDashboardDto>("api/dispatch/dashboard");
            await Task.WhenAll(boardTask, driversTask, centreTask);
            Jobs = boardTask.Result ?? [];
            Drivers = driversTask.Result ?? [];
            Centre = centreTask.Result;
            foreach (var job in Jobs.Where(x => x.DriverId.HasValue)) DriverSelections[job.BookingId] = job.DriverId!.Value;
        }
        catch (Exception) { Error = "Dispatch data could not be loaded. Make sure LondonVIP.Api is running."; }
        finally { Loading = false; }
    }

    private RenderFragment BoardColumn(string title, string description, List<DispatchBoardItemDto> items, string tone) => @<section class="dispatch-column @tone">
        <header><div><h2>@title</h2><p>@description</p></div><span>@items.Count</span></header>
        <div class="dispatch-cards">
            @if (items.Count == 0) { <p class="column-empty">No jobs in this stage.</p> }
            @foreach (var job in items) { @JobCard(job) }
        </div>
    </section>;

    private RenderFragment JobCard(DispatchBoardItemDto job) => @<article class="dispatch-card timing-@job.TimingState.ToString().ToLowerInvariant()" id="dispatch-@job.BookingId">
        <div class="card-top"><div><strong>@job.BookingReference</strong><span>@job.PickupDateTime.LocalDateTime.ToString("dd MMM · HH:mm")</span></div><em>@TimingLabel(job)</em></div>
        <h3>@job.CustomerName</h3>
        <div class="route"><span>@job.PickupAddress</span><small>to</small><span>@job.Destination</span></div>
        @if (!string.IsNullOrWhiteSpace(job.AirportCode) || !string.IsNullOrWhiteSpace(job.FlightNumber)) { <p class="flight">Airport: @(job.AirportCode ?? "—") · Flight: @(job.FlightNumber ?? "—")</p> }
        <dl><div><dt>Vehicle</dt><dd>@Display(job.VehicleType)</dd></div><div><dt>Fare</dt><dd>@job.TotalFare.ToString("C", UkCulture)</dd></div><div><dt>Payment</dt><dd>@job.PaymentStatus</dd></div><div><dt>Status</dt><dd>@Display(job.Status)</dd></div></dl>
        <div class="driver-line"><span>Driver</span><strong>@(job.DriverName ?? "Unassigned")</strong>@if (!string.IsNullOrWhiteSpace(job.DriverVehicleRegistration)) { <small>@job.DriverVehicleRegistration</small> }</div>
        @if (job.Status is BookingStatus.Confirmed or BookingStatus.Assigned)
        {
            <label class="driver-select"><span>Choose active driver</span><select value="@SelectedDriver(job)" @onchange="args => SelectDriver(job.BookingId, args.Value?.ToString())"><option value="">Select driver</option>@foreach (var driver in Drivers) { <option value="@driver.DriverId">@DriverLabel(driver)</option> }</select></label>
            <div class="card-actions"><button type="button" disabled="@(BusyBooking == job.BookingId || !DriverSelections.ContainsKey(job.BookingId))" @onclick="() => AssignAsync(job)">@(job.DriverId is null ? "Assign driver" : "Reassign")</button>@if (job.Status == BookingStatus.Assigned) { <button type="button" class="secondary" disabled="@(BusyBooking == job.BookingId)" @onclick="() => UnassignAsync(job)">Unassign</button> }</div>
        }
        @if (NextStatus(job.Status) is { } next) { <button type="button" class="progress-button" disabled="@(BusyBooking == job.BookingId)" @onclick="() => UpdateStatusAsync(job, next)">Move to @Display(next)</button> }
    </article>;

    private string SelectedDriver(DispatchBoardItemDto job) => DriverSelections.TryGetValue(job.BookingId, out var id) ? id.ToString() : string.Empty;
    private void SelectDriver(Guid bookingId, string? value) { if (Guid.TryParse(value, out var id)) DriverSelections[bookingId] = id; else DriverSelections.Remove(bookingId); }
    private async Task AssignAsync(DispatchBoardItemDto job) { if (DriverSelections.TryGetValue(job.BookingId, out var id)) await PatchAsync(job.BookingId, "assign", new AssignDriverRequest { DriverId = id }); }
    private Task UnassignAsync(DispatchBoardItemDto job) => PatchAsync(job.BookingId, "unassign", new UnassignDriverRequest());
    private Task UpdateStatusAsync(DispatchBoardItemDto job, BookingStatus status) => PatchAsync(job.BookingId, "status", new DispatchStatusUpdateDto { Status = status });

    private async Task PatchAsync<T>(Guid bookingId, string action, T payload)
    {
        BusyBooking = bookingId; Error = null;
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Patch, $"api/dispatch/{bookingId}/{action}") { Content = JsonContent.Create(payload) };
            using var response = await Client().SendAsync(request);
            if (!response.IsSuccessStatusCode) { var problem = await response.Content.ReadFromJsonAsync<ApiError>(); Error = problem?.Message ?? "The dispatch action could not be completed."; return; }
            await LoadAsync();
        }
        catch (Exception) { Error = "The dispatch action could not reach the API."; }
        finally { BusyBooking = null; }
    }

    private HttpClient Client() => HttpClientFactory.CreateClient("LondonVIP.Api");
    private async Task SearchAsync(){if(string.IsNullOrWhiteSpace(SearchTerm)){SearchResults=[];return;}SearchResults=await Client().GetFromJsonAsync<List<DispatchSearchResultDto>>($"api/dispatch/search?q={Uri.EscapeDataString(SearchTerm)}")??[];}
    private static IEnumerable<(string Label,string Value)> Metrics(DispatchKpiDto x)=>[("Bookings Waiting",x.BookingsWaiting.ToString()),("Assigned",x.Assigned.ToString()),("Drivers Available",x.DriversAvailable.ToString()),("Drivers Busy",x.DriversBusy.ToString()),("Drivers Offline",x.DriversOffline.ToString()),("Airport Jobs Today",x.AirportJobsToday.ToString()),("Corporate Jobs Today",x.CorporateJobsToday.ToString()),("Completed Today",x.CompletedToday.ToString()),("Cancelled Today",x.CancelledToday.ToString()),("Revenue Today",x.RevenueToday.ToString("C",UkCulture)),("Average ETA",x.AverageEtaMinutes?.ToString("0")+" min"??"Not available"),("Average Response",x.AverageResponseMinutes?.ToString("0")+" min"??"Not available"),("Outstanding Alerts",x.OutstandingAlerts.ToString())];
    private static string DisplayText(string value)=>System.Text.RegularExpressions.Regex.Replace(value,"([a-z])([A-Z])","$1 $2");
    private static BookingStatus? NextStatus(BookingStatus status) => status switch { BookingStatus.Assigned => BookingStatus.DriverEnRoute, BookingStatus.DriverEnRoute => BookingStatus.PassengerOnBoard, BookingStatus.PassengerOnBoard => BookingStatus.Completed, _ => null };
    private static string DriverLabel(DriverAvailabilityDto driver) => string.Join(" · ", new[] { driver.DriverName, driver.VehicleDisplay, driver.RegistrationNumber }.Where(x => !string.IsNullOrWhiteSpace(x)));
    private static string TimingLabel(DispatchBoardItemDto job) => job.TimingState switch { DispatchTimingState.Overdue => "Pickup overdue", DispatchTimingState.Approaching => "Pickup approaching", DispatchTimingState.Active => "Active journey", _ => job.DriverId is null ? "Unassigned" : "Scheduled" };
    private static string Display<T>(T value) where T : Enum => System.Text.RegularExpressions.Regex.Replace(value.ToString(), "([a-z])([A-Z])", "$1 $2");
    private sealed class ApiError { public string? Message { get; set; } }
}
