@page "/driver"
@attribute [Authorize(Roles="Driver")]
@layout DriverLayout
@rendermode InteractiveServer
@using LondonVIP.Shared.Drivers
@inject IHttpClientFactory Clients
<PageTitle>Driver Home | London VIP Cars</PageTitle>
@if (loading) { <div class="driver-state">Loading your working day...</div> }
else if (error is not null) { <div class="driver-state error" role="alert">@error</div> }
else if (model is not null) { <div class="driver-home"><header><span>Welcome back</span><h1>@model.Profile.Name</h1><div class="status">@model.Profile.Status</div></header><section class="actions"><button @onclick="GoOnline">Go online</button><button @onclick="GoOffline" class="secondary">Go offline</button><button @onclick="StartBreak" class="secondary">Start break</button></section><section class="metrics"><article><strong>@model.JobsToday</strong><span>Jobs today</span></article><article><strong>@model.CompletedToday</strong><span>Completed</span></article><article><strong>@(model.EarningsToday?.ToString("C") ?? "Unavailable")</strong><span>Journey value</span></article><article><strong>@model.DocumentWarnings</strong><span>Warnings</span></article></section>@if (model.CurrentJob is not null) { <article class="current"><span>Current job - @model.CurrentJob.Status</span><h2>@model.CurrentJob.BookingReference</h2><time>@model.CurrentJob.PickupDateTime.LocalDateTime.ToString("HH:mm")</time><p>@model.CurrentJob.PickupAddress</p><b>to</b><p>@model.CurrentJob.Destination</p><a href="/driver/jobs/@model.CurrentJob.Id">Open job</a></article> } else { <article><h2>No active journey</h2><p>Your next assigned job will appear here.</p></article> }<section class="details"><article><h2>Vehicle</h2><strong>@(model.Profile.Vehicle?.Registration ?? "Not assigned")</strong></article><article><h2>Shift</h2><strong>@(model.CurrentShift is null ? "Not started" : "Active")</strong><button @onclick="ToggleShift">@(model.CurrentShift is null ? "Start shift" : "End shift")</button></article><article><h2>Next pickup</h2><strong>@(model.NextJob?.PickupDateTime.LocalDateTime.ToString("HH:mm") ?? "-")</strong></article></section>@if (message is not null) { <div class="toast" role="status">@message</div> }</div> }
<style>.driver-state,.driver-home article{background:#fff;border:1px solid #dce4e1;border-radius:1rem;padding:1rem}.driver-home{display:grid;gap:1rem}.driver-home>header{position:relative}.driver-home h1{font:2rem Georgia,serif;margin:.1rem 0}.driver-home>header>span{font-size:.7rem;text-transform:uppercase;color:#a67c2e}.status{position:absolute;right:0;top:.5rem;border-radius:2rem;padding:.35rem .65rem;background:#d9f1e3;font-size:.7rem}.actions{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem}.actions button,.current a,.details button{min-height:3rem;border:0;border-radius:.7rem;background:#173f36;color:#fff;padding:.7rem;text-decoration:none;text-align:center}.actions .secondary{background:#fff;color:#173f36;border:1px solid #9db0aa}.metrics{display:grid;grid-template-columns:repeat(2,1fr);gap:.6rem}.metrics article{display:grid}.metrics strong{font-size:1.4rem}.metrics span{font-size:.68rem;color:#6c7c77}.current{border-left:5px solid #c39743!important}.current span{color:#92702c;text-transform:uppercase;font-size:.65rem}.current h2{font:1.5rem Georgia,serif}.current a{display:block;margin-top:1rem}.details{display:grid;gap:.6rem}.details article{display:grid;gap:.3rem}.details h2{font-size:.7rem;text-transform:uppercase;color:#6c7c77}.toast{position:fixed;bottom:5rem;left:1rem;right:1rem;background:#173f36;color:#fff;padding:1rem;border-radius:.7rem}@@media(min-width:700px){.metrics{grid-template-columns:repeat(4,1fr)}.details{grid-template-columns:repeat(3,1fr)}}</style>
@code { private DriverPortalDashboardDto? model; private bool loading = true; private string? error; private string? message; protected override Task OnInitializedAsync() => LoadAsync(); private async Task LoadAsync(){try{model=await Clients.CreateClient("LondonVIP.Api").GetFromJsonAsync<DriverPortalDashboardDto>("api/driver/dashboard");}catch(Exception ex){error=ex.Message;}finally{loading=false;}} private Task GoOnline()=>SetStatusAsync("online"); private Task GoOffline()=>SetStatusAsync("offline"); private Task StartBreak()=>SetBreakAsync("start"); private async Task SetStatusAsync(string value){var response=await Clients.CreateClient("LondonVIP.Api").PostAsync($"api/driver/status/{value}",null);message=await response.Content.ReadAsStringAsync();await LoadAsync();} private async Task SetBreakAsync(string value){var response=await Clients.CreateClient("LondonVIP.Api").PostAsync($"api/driver/status/break/{value}",null);message=await response.Content.ReadAsStringAsync();await LoadAsync();} private async Task ToggleShift(){var action=model?.CurrentShift is null?"start":"end";var response=await Clients.CreateClient("LondonVIP.Api").PostAsync($"api/driver/shift/{action}",null);message=await response.Content.ReadAsStringAsync();await LoadAsync();} }
