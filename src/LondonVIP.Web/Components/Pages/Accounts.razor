@page "/erp/accounts"
@page "/erp/corporate-accounts"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer
@using LondonVIP.Shared.CorporateAccounts
@using LondonVIP.Shared.Models
@inject IHttpClientFactory HttpClientFactory
<PageTitle>Corporate Accounts | London VIP Cars ERP</PageTitle>
<div class="accounts-page"><header><div><span>CRM &amp; finance</span><h1>Corporate accounts</h1><p>Manage tenant-owned business accounts and real corporate booking activity.</p></div><button class="primary" @onclick="New">+ Create account</button></header>
@if(Loading){<div class="state">Loading corporate accounts...</div>}else if(Error is not null){<div class="state error">@Error</div>}else{<section class="summary"><div><strong>@Summary.ActiveAccounts</strong><span>Active accounts</span></div><div><strong>@Summary.AccountsOnHold</strong><span>On hold</span></div><div><strong>@Summary.AccountsWithCreditLimit</strong><span>Credit limits set</span></div><div><strong>@Summary.CorporateBookings</strong><span>Corporate bookings</span></div></section><p class="balance-note">Current balance remains £0.00 until a future invoicing/payment ledger is introduced.</p><section class="filters"><label>Search<input type="search" @bind="Search" @bind:event="oninput" placeholder="Account, contact, email"/></label><label>Active<select @bind="Active"><option value="all">All</option><option value="active">Active</option><option value="inactive">Inactive</option></select></label><label>Hold<select @bind="Hold"><option value="all">All</option><option value="hold">On hold</option><option value="clear">Not on hold</option></select></label><label>Terms<select @bind="Terms"><option value="">All terms</option>@foreach(var x in Enum.GetValues<BillingTerms>()){<option value="@x">@Display(x)</option>}</select></label></section>
@if(Filtered.Count==0){<div class="state"><h2>No accounts found</h2><p>No real corporate account records match these filters.</p></div>}else{<div class="table-wrap"><table><thead><tr><th>Account</th><th>Contact</th><th>Terms</th><th>Credit limit</th><th>Hold</th><th>Last booking</th><th></th></tr></thead><tbody>@foreach(var a in Filtered){<tr><td data-label="Account"><strong>@a.AccountNumber</strong><small>@a.AccountName</small></td><td data-label="Contact">@a.PrimaryContactName<small>@a.Email</small></td><td data-label="Terms">@Display(a.BillingTerms)</td><td data-label="Credit limit">@(a.CreditLimit?.ToString("C",Culture)??"Not set")</td><td data-label="Hold"><span class="pill @(a.IsOnHold?"hold":"valid")">@(a.IsOnHold?"On hold":"Clear")</span></td><td data-label="Last booking">@(a.LastBookingDate?.LocalDateTime.ToString("dd MMM yyyy")??"—")</td><td><button @onclick="()=>Edit(a.Id)">Edit</button><button @onclick="()=>Toggle(a)">@(a.IsOnHold?"Remove hold":"Place on hold")</button></td></tr>}</tbody></table></div>}}</div>
@if(Editing){<div class="backdrop"><section class="editor"><header><h2>@(Id.HasValue?"Edit corporate account":"Create corporate account")</h2><button @onclick="Close">×</button></header>@if(Errors.Count>0){<div class="error"><ul>@foreach(var e in Errors){<li>@e</li>}</ul></div>}<EditForm Model="Form" OnSubmit="Save"><div class="form-grid"><label>Account number *<input @bind="Form.AccountNumber"/></label><label>Account name *<input @bind="Form.AccountName"/></label><label>Trading name<input @bind="Form.TradingName"/></label><label>Primary contact *<input @bind="Form.PrimaryContactName"/></label><label>Email *<input type="email" @bind="Form.Email"/></label><label>Phone *<input @bind="Form.Phone"/></label><label>Billing email<input type="email" @bind="Form.BillingEmail"/></label><label>Billing terms<select @bind="Form.BillingTerms">@foreach(var x in Enum.GetValues<BillingTerms>()){<option value="@x">@Display(x)</option>}</select></label><label>Credit limit<input type="number" min="0" step="0.01" @bind="Form.CreditLimit"/></label><label>Address line 1 *<input @bind="Form.AddressLine1"/></label><label>Address line 2<input @bind="Form.AddressLine2"/></label><label>Town/city *<input @bind="Form.TownCity"/></label><label>Postcode *<input @bind="Form.Postcode"/></label><label>Country *<input @bind="Form.Country"/></label><label>Default PO reference<input @bind="Form.DefaultPurchaseOrderReference"/></label><label class="check"><input type="checkbox" @bind="Form.PurchaseOrderRequired"/> Purchase order required</label><label class="check"><input type="checkbox" @bind="Form.IsActive"/> Active</label><label class="check"><input type="checkbox" @bind="Form.IsOnHold"/> On hold</label><label class="wide">Notes<textarea @bind="Form.Notes"></textarea></label></div><footer><button type="button" @onclick="Close">Cancel</button><button class="primary" type="submit" disabled="@Saving">Save account</button></footer></EditForm></section></div>}
@code{static readonly System.Globalization.CultureInfo Culture=System.Globalization.CultureInfo.GetCultureInfo("en-GB");List<CorporateAccountListItemDto> Items=[];CorporateAccountSummaryDto Summary=new();CorporateAccountUpdateDto Form=new();Guid? Id;bool Loading=true,Editing,Saving;string? Error;string Search="",Active="all",Hold="all",Terms="";List<string> Errors=[];List<CorporateAccountListItemDto> Filtered=>Items.Where(x=>(string.IsNullOrWhiteSpace(Search)||$"{x.AccountNumber} {x.AccountName} {x.PrimaryContactName} {x.Email}".Contains(Search,StringComparison.OrdinalIgnoreCase))&&(Active=="all"||x.IsActive==(Active=="active"))&&(Hold=="all"||x.IsOnHold==(Hold=="hold"))&&(Terms==""||x.BillingTerms.ToString()==Terms)).ToList();protected override Task OnInitializedAsync()=>Load();HttpClient Client()=>HttpClientFactory.CreateClient("LondonVIP.Api");async Task Load(){Loading=true;try{var a=Client().GetFromJsonAsync<List<CorporateAccountListItemDto>>("api/accounts");var b=Client().GetFromJsonAsync<CorporateAccountSummaryDto>("api/accounts/summary");await Task.WhenAll(a,b);Items=a.Result??[];Summary=b.Result??new();Error=null;}catch{Error="Corporate accounts could not be loaded.";}finally{Loading=false;}}void New(){Id=null;Form=new(){IsActive=true};Errors=[];Editing=true;}async Task Edit(Guid id){var a=await Client().GetFromJsonAsync<CorporateAccountDetailDto>($"api/accounts/{id}");if(a is null)return;Id=id;Form=new(){AccountNumber=a.AccountNumber,AccountName=a.AccountName,TradingName=a.TradingName,PrimaryContactName=a.PrimaryContactName,Email=a.Email,Phone=a.Phone,BillingEmail=a.BillingEmail,AddressLine1=a.AddressLine1,AddressLine2=a.AddressLine2,TownCity=a.TownCity,Postcode=a.Postcode,Country=a.Country,BillingTerms=a.BillingTerms,CreditLimit=a.CreditLimit,IsActive=a.IsActive,IsOnHold=a.IsOnHold,PurchaseOrderRequired=a.PurchaseOrderRequired,DefaultPurchaseOrderReference=a.DefaultPurchaseOrderReference,Notes=a.Notes};Errors=[];Editing=true;}async Task Save(){Saving=true;Errors=[];try{var r=Id.HasValue?await Client().PutAsJsonAsync($"api/accounts/{Id}",Form):await Client().PostAsJsonAsync("api/accounts",Form);if(r.IsSuccessStatusCode){Editing=false;await Load();}else await Read(r);}finally{Saving=false;}}async Task Toggle(CorporateAccountListItemDto a){using var r=new HttpRequestMessage(HttpMethod.Patch,$"api/accounts/{a.Id}/status"){Content=JsonContent.Create(new CorporateAccountStatusDto{IsActive=a.IsActive,IsOnHold=!a.IsOnHold})};await Client().SendAsync(r);await Load();}void Close()=>Editing=false;async Task Read(HttpResponseMessage r){try{var p=await r.Content.ReadFromJsonAsync<Problem>();Errors=p?.Errors.SelectMany(x=>x.Value).ToList()??["Account could not be saved."];}catch{Errors=["Account could not be saved."];}}static string Display<T>(T x)=>System.Text.RegularExpressions.Regex.Replace(x?.ToString()??"","([a-z])([A-Z])","$1 $2");sealed class Problem{public Dictionary<string,string[]> Errors{get;set;}=[];}}
