@page "/erp/automation"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer
@using LondonVIP.Shared.Workflows
@using LondonVIP.Shared.Models
@inject IHttpClientFactory HttpClientFactory
<PageTitle>Automation | London VIP Cars ERP</PageTitle>
<div class="automation"><header><div><span>Platform operations</span><h1>Workflow Automation</h1><p>Scheduled processing, business events, reminders, retries and escalations.</p></div><button @onclick="Load">Refresh</button></header>
<nav>@foreach(var tab in Tabs){<button class="@(Tab==tab? "active":null)" @onclick="()=>Select(tab)">@tab</button>}</nav>
@if(Loading){<p class="state">Loading workflow activity...</p>}else if(Dashboard is null){<p class="state error">@Error</p>}else{
<section class="metrics"><article><strong>@Dashboard.JobsWaiting</strong><span>Jobs Waiting</span></article><article><strong>@Dashboard.JobsCompleted</strong><span>Jobs Completed</span></article><article><strong>@Dashboard.JobsFailed</strong><span>Jobs Failed</span></article><article><strong>@Dashboard.RetryQueue</strong><span>Retry Queue</span></article><article><strong>@Dashboard.UpcomingReminders</strong><span>Upcoming Reminders</span></article><article><strong>@Dashboard.TodaysEvents</strong><span>Today's Events</span></article><article><strong>@Dashboard.AutomationsTriggered</strong><span>Automations Triggered</span></article><article><strong>@Dashboard.Escalations</strong><span>Escalations</span></article></section>
<section class="panel"><header><h2>@Tab</h2><input type="search" placeholder="Search workflow, job or reference" @bind="Search" @bind:event="oninput"/></header>
@if(Tab=="Business Events"){@foreach(var item in Events.Where(Matches)){<div class="row"><div><strong>@item.EventType</strong><span>@item.ResourceType · @item.CorrelationId</span></div><time>@item.OccurredAt.LocalDateTime.ToString("dd MMM HH:mm")</time></div>}}
else{@foreach(var job in FilteredJobs){<div class="row"><div><strong>@job.WorkflowType</strong><span>@job.Status · @job.Kind · attempt @job.AttemptCount/@job.MaxAttempts</span></div><time>@job.ScheduledAt.LocalDateTime.ToString("dd MMM HH:mm")</time>@if(job.Status is WorkflowJobStatus.Failed or WorkflowJobStatus.Escalated){<button @onclick="()=>Retry(job.Id)">Retry</button>}@if(job.Status is WorkflowJobStatus.Waiting or WorkflowJobStatus.Scheduled or WorkflowJobStatus.Retrying){<button @onclick="()=>Run(job.Id)">Run</button><button @onclick="()=>Cancel(job.Id)">Cancel</button>}</div>}}</section>}</div>
<style>.automation{display:grid;gap:1rem}.automation>header,.panel>header{display:flex;justify-content:space-between;gap:1rem;align-items:end}.automation h1{font:clamp(2rem,4vw,3rem) Georgia,serif;margin:.2rem 0}.automation header span{color:#986b26;font-size:.7rem;text-transform:uppercase}.automation nav{display:flex;gap:.4rem;overflow:auto}.automation button{border:1px solid #d8e2de;border-radius:.5rem;background:#fff;color:#315f53;padding:.55rem .75rem}.automation nav .active{background:#17473e;color:#fff}.metrics{display:grid;grid-template-columns:repeat(2,1fr);gap:.6rem}.metrics article,.panel,.state{background:#fff;border:1px solid #dfe7e4;border-radius:.8rem;padding:1rem}.metrics strong,.metrics span{display:block}.metrics strong{font:1.6rem Georgia,serif}.metrics span,.row span{color:#71817d;font-size:.65rem}.panel input{border:1px solid #bdcac6;border-radius:.45rem;padding:.6rem}.row{display:flex;align-items:center;gap:.6rem;border-top:1px solid #edf1ef;padding:.7rem 0}.row>div{flex:1}.row strong,.row span{display:block}.row time{font-size:.65rem}@@media(min-width:800px){.metrics{grid-template-columns:repeat(4,1fr)}}@@media(max-width:600px){.automation>header,.panel>header{align-items:start;flex-direction:column}.panel input{width:100%}}</style>
@code{WorkflowDashboardDto? Dashboard;List<WorkflowJobDto> Jobs=[];List<BusinessEventDto> Events=[];bool Loading=true;string? Error;string Tab="Workflow Dashboard",Search="";static readonly string[] Tabs=["Workflow Dashboard","Scheduled Jobs","Business Events","Workflow History","Failed Jobs","Retry Queue","Upcoming Reminders","Rule Engine"];protected override Task OnInitializedAsync()=>Load();async Task Load(){Loading=true;try{var c=HttpClientFactory.CreateClient("LondonVIP.Api");var d=c.GetFromJsonAsync<WorkflowDashboardDto>("api/workflows/dashboard");var j=c.GetFromJsonAsync<WorkflowPageDto<WorkflowJobDto>>("api/workflows/jobs?pageSize=100");var e=c.GetFromJsonAsync<WorkflowPageDto<BusinessEventDto>>("api/workflows/events?pageSize=100");await Task.WhenAll(d,j,e);Dashboard=d.Result;Jobs=j.Result?.Items??[];Events=e.Result?.Items??[];}catch{Error="Workflow data could not be loaded.";}finally{Loading=false;}}void Select(string tab)=>Tab=tab;bool Matches(BusinessEventDto x)=>string.IsNullOrWhiteSpace(Search)||$"{x.EventType} {x.ResourceType} {x.CorrelationId}".Contains(Search,StringComparison.OrdinalIgnoreCase);IEnumerable<WorkflowJobDto> FilteredJobs=>Jobs.Where(x=>(Tab switch{"Scheduled Jobs"=>x.Status is WorkflowJobStatus.Waiting or WorkflowJobStatus.Scheduled,"Workflow History"=>x.Status==WorkflowJobStatus.Completed,"Failed Jobs"=>x.Status is WorkflowJobStatus.Failed or WorkflowJobStatus.Escalated,"Retry Queue"=>x.Status==WorkflowJobStatus.Retrying,"Upcoming Reminders"=>x.WorkflowType.Contains("Reminder"),_=>true})&&(string.IsNullOrWhiteSpace(Search)||$"{x.WorkflowType} {x.CorrelationId}".Contains(Search,StringComparison.OrdinalIgnoreCase)));Task Retry(Guid id)=>Action(id,"retry");Task Run(Guid id)=>Action(id,"run");Task Cancel(Guid id)=>Action(id,"cancel");async Task Action(Guid id,string action){await HttpClientFactory.CreateClient("LondonVIP.Api").PostAsync($"api/workflows/jobs/{id}/{action}",null);await Load();}}
