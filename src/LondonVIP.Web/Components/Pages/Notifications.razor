@page "/erp/communications"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer
@using LondonVIP.Shared.Notifications
@using LondonVIP.Shared.Models
@using LondonVIP.Shared.Crm
@inject IHttpClientFactory HttpClientFactory
<PageTitle>Communications Hub | London VIP Cars ERP</PageTitle>
<div class="notification-page"><header><div><span>Social CRM</span><h1>Communications Hub</h1><p>One tenant-scoped inbox for conversations and delivery operations.</p></div><button @onclick="LoadAsync">Refresh</button></header><nav class="channel-tabs">@foreach(var tab in Tabs){<button class="@(Tab==tab?"active":null)" @onclick="()=>Tab=tab">@tab</button>}</nav><section class="filters"><input type="search" placeholder="Customer, address, subject or message" @bind="Search" @bind:event="oninput"/><select @bind="Status"><option value="">All delivery statuses</option>@foreach(var s in Enum.GetValues<NotificationStatus>()){<option value="@((int)s)">@s</option>}</select></section>@if(Loading){<p>Loading communications...</p>}else{<section class="inbox"><h2>Conversation inbox</h2>@foreach(var thread in FilteredConversations){<article><div><strong>@thread.Subject</strong><span>@thread.ParticipantAddress · @thread.Channel · @thread.MessageCount messages</span></div><span class="pill">@(thread.IsUnread?"Unread":"Read")</span><small>@thread.UpdatedAt.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</small></article>}@if(!FilteredConversations.Any()){<p>No conversations match this view.</p>}</section><div class="list"><h2>Delivery queue</h2>@foreach(var item in Filtered){<article><div><strong>@item.Subject</strong><span>@item.Recipient · @item.Channel · @item.NotificationType</span></div><span class="pill @item.Status.ToString().ToLowerInvariant()">@item.Status</span><p>@item.Body</p><small>@item.CreatedAt.LocalDateTime.ToString("dd MMM yyyy, HH:mm") · Retries @item.RetryCount · @item.CorrelationId</small>@if(item.Status is NotificationStatus.Pending or NotificationStatus.Failed or NotificationStatus.Sent){<button @onclick="()=>ResendAsync(item.Id)">@(item.Status==NotificationStatus.Failed?"Retry":"Resend")</button>}</article>}</div>}</div>
<style>.channel-tabs{display:flex;gap:.4rem;overflow:auto;margin:.8rem 0}.channel-tabs button{white-space:nowrap}.channel-tabs .active{background:#17473e;color:#fff}.inbox{background:#fff;border:1px solid #dfe7e4;border-radius:.8rem;padding:1rem;margin:1rem 0}.inbox article{display:flex;align-items:center;gap:1rem;border-top:1px solid #edf1ef;padding:.7rem 0}.inbox article>div{flex:1}.inbox strong,.inbox span{display:block}.inbox span,.inbox small{color:#71817d;font-size:.72rem}</style>
@code{private static readonly string[] Tabs=["Inbox","WhatsApp","Facebook","Instagram","LinkedIn","Google Business","Email","SMS","Calls","Reviews","Templates","Automations","AI Assistant"];private List<NotificationDto> Items=[];private List<ConversationDto> Conversations=[];private bool Loading=true;private string Search="";private string Status="";private string Tab="Inbox";private List<NotificationDto> Filtered=>Items.Where(x=>(string.IsNullOrWhiteSpace(Search)||$"{x.Recipient} {x.Subject}".Contains(Search,StringComparison.OrdinalIgnoreCase))&&(string.IsNullOrEmpty(Status)||((int)x.Status).ToString()==Status)).ToList();private IEnumerable<ConversationDto> FilteredConversations=>Conversations.Where(x=>(Tab=="Inbox"||x.Channel.ToString().Contains(Tab.Replace(" ",""),StringComparison.OrdinalIgnoreCase))&&(string.IsNullOrWhiteSpace(Search)||$"{x.Subject} {x.ParticipantAddress} {x.CustomerName}".Contains(Search,StringComparison.OrdinalIgnoreCase)));protected override Task OnInitializedAsync()=>LoadAsync();private async Task LoadAsync(){Loading=true;try{var n=Client().GetFromJsonAsync<List<NotificationDto>>("api/notifications");var c=Client().GetFromJsonAsync<List<ConversationDto>>("api/crm/conversations");await Task.WhenAll(n,c);Items=n.Result??[];Conversations=c.Result??[];}finally{Loading=false;}}private async Task ResendAsync(Guid id){await Client().PostAsync($"api/notifications/{id}/resend",null);await LoadAsync();}private HttpClient Client()=>HttpClientFactory.CreateClient("LondonVIP.Api");}
