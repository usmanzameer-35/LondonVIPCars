@page "/erp/communications"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer
@using LondonVIP.Shared.Notifications
@using LondonVIP.Shared.Models
@inject IHttpClientFactory HttpClientFactory
<PageTitle>Notifications | London VIP Cars ERP</PageTitle>
<div class="notification-page"><header><div><span>Communications</span><h1>Notification administration</h1><p>Tenant-scoped delivery queue and development provider history.</p></div><button @onclick="LoadAsync">Refresh</button></header><section class="filters"><input type="search" placeholder="Recipient or subject" @bind="Search" @bind:event="oninput"/><select @bind="Status"><option value="">All statuses</option>@foreach(var s in Enum.GetValues<NotificationStatus>()){<option value="@((int)s)">@s</option>}</select></section>@if(Loading){<p>Loading notifications...</p>}else{<div class="list">@foreach(var item in Filtered){<article><div><strong>@item.Subject</strong><span>@item.Recipient · @item.Channel · @item.NotificationType</span></div><span class="pill @item.Status.ToString().ToLowerInvariant()">@item.Status</span><p>@item.Body</p><small>@item.CreatedAt.LocalDateTime.ToString("dd MMM yyyy, HH:mm") · Retries @item.RetryCount · @item.CorrelationId</small>@if(item.Status is NotificationStatus.Pending or NotificationStatus.Failed or NotificationStatus.Sent){<button @onclick="()=>ResendAsync(item.Id)">@(item.Status==NotificationStatus.Failed?"Retry":"Resend")</button>}</article>}</div>}</div>
@code{private List<NotificationDto> Items=[];private bool Loading=true;private string Search="";private string Status="";private List<NotificationDto> Filtered=>Items.Where(x=>(string.IsNullOrWhiteSpace(Search)||$"{x.Recipient} {x.Subject}".Contains(Search,StringComparison.OrdinalIgnoreCase))&&(string.IsNullOrEmpty(Status)||((int)x.Status).ToString()==Status)).ToList();protected override Task OnInitializedAsync()=>LoadAsync();private async Task LoadAsync(){Loading=true;try{Items=await Client().GetFromJsonAsync<List<NotificationDto>>("api/notifications")??[];}finally{Loading=false;}}private async Task ResendAsync(Guid id){await Client().PostAsync($"api/notifications/{id}/resend",null);await LoadAsync();}private HttpClient Client()=>HttpClientFactory.CreateClient("LondonVIP.Api");}
