@page "/erp/map"
@page "/erp/live-tracking"
@page "/erp/journey-replay"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer
@using LondonVIP.Shared.Maps
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Live Journey Intelligence | London VIP Cars ERP</PageTitle>
<div class="map-page">
    <header><div><span>Operations</span><h1>Live Journey Intelligence</h1><p>Tenant-safe driver positions, current journeys and operational geography.</p></div><button @onclick="LoadAsync" disabled="@loading">Refresh</button></header>
    <section class="map-tools"><input type="search" @bind="search" placeholder="Driver, booking or vehicle"/><button @onclick="SearchAsync">Search</button><label><input type="checkbox" @bind="onlineOnly"/> Online only</label></section>
    @if (loading) { <div class="state">Loading live positions…</div> }
    else if (error is not null) { <div class="state error" role="alert">@error</div> }
    else
    {
        <section class="map-grid">
            <article class="map-canvas" aria-label="Provider-neutral live map">
                <div class="map-empty"><strong>Live map surface</strong><span>Map tiles and traffic overlays activate when a provider key is configured.</span></div>
                @foreach (var driver in VisibleDrivers) { <button class="marker" title="@driver.DriverName" style="@MarkerStyle(driver)">●<span>@driver.DriverName</span></button> }
            </article>
            <aside><h2>Drivers</h2>@if (!VisibleDrivers.Any()) { <p>No current driver locations.</p> }@foreach (var driver in VisibleDrivers) { <div class="driver"><i class="@(driver.IsOnline ? "online" : "offline")"></i><div><strong>@driver.DriverName</strong><small>@(driver.Registration ?? "No vehicle") · @(driver.BookingReference ?? "Available")</small><small>@driver.Timestamp.LocalDateTime.ToString("dd MMM HH:mm:ss") · @(driver.Speed?.ToString("0") ?? "—") mph</small></div></div> }</aside>
        </section>
        @if (results.Count > 0) { <section class="results"><h2>Search results</h2>@foreach (var item in results) { <div><strong>@item.Type · @item.Label</strong><span>@item.Subtitle</span></div> }</section> }
        <section class="intelligence"><article><h2>Journey routes</h2><p>Fastest/shortest routing, stops and toll preferences are available through the provider-neutral route API.</p></article><article><h2>Airports & geofences</h2><p>@(map?.Geofences.Count ?? 0) active geofences · @(map?.Locations.Count ?? 0) global airports</p></article><article><h2>Journey replay</h2><p>Select a booking through search to load its timestamped GPS history.</p></article></section>
    }
</div>
<style>
.map-page{display:grid;gap:1rem}.map-page header,.map-tools{display:flex;align-items:center;justify-content:space-between;gap:1rem}.map-page h1{font:2rem Georgia,serif;margin:.15rem 0}.map-page header span{color:#9b762e;text-transform:uppercase;font-size:.7rem;letter-spacing:.12em}.map-page button{border:0;border-radius:.45rem;background:#173f36;color:#fff;padding:.65rem .9rem}.map-tools{justify-content:flex-start;background:#fff;border:1px solid #dce5e2;padding:.75rem;border-radius:.75rem}.map-tools input{flex:1;border:1px solid #bccbc6;border-radius:.4rem;padding:.65rem}.map-grid{display:grid;gap:1rem}.map-canvas{position:relative;min-height:34rem;overflow:hidden;border-radius:1rem;background:linear-gradient(35deg,#dbe8e3,#f4f1e7);border:1px solid #ccd9d5}.map-canvas:before{content:"";position:absolute;inset:0;background-image:linear-gradient(#fff6 1px,transparent 1px),linear-gradient(90deg,#fff6 1px,transparent 1px);background-size:40px 40px}.map-empty{position:absolute;inset:1rem auto auto 1rem;background:#fffffff0;border-radius:.5rem;padding:.7rem;display:grid}.map-empty span{font-size:.7rem;color:#697a75}.marker{position:absolute!important;padding:.35rem!important;border-radius:1rem!important;background:#bf8d34!important}.marker span{display:none}.marker:hover span{display:block;position:absolute;left:1rem;top:1rem;background:#fff;color:#173f36;padding:.4rem;white-space:nowrap}.map-grid aside,.results,.intelligence article{background:#fff;border:1px solid #dce5e2;border-radius:.75rem;padding:1rem}.driver{display:flex;gap:.6rem;padding:.65rem 0;border-top:1px solid #edf1ef}.driver i{width:.65rem;height:.65rem;border-radius:50%;margin-top:.25rem}.driver i.online{background:#37a56b}.driver i.offline{background:#9aa5a2}.driver div{display:grid}.driver small{color:#6c7c77;font-size:.68rem}.results div{display:flex;justify-content:space-between;border-top:1px solid #edf1ef;padding:.5rem}.intelligence{display:grid;gap:1rem}.state{padding:2rem;text-align:center;background:#fff}.error{color:#9b2f2f}@@media(min-width:850px){.map-grid{grid-template-columns:minmax(0,3fr) minmax(16rem,1fr)}.intelligence{grid-template-columns:repeat(3,1fr)}}@@media(max-width:600px){.map-page header,.map-tools{align-items:stretch;flex-direction:column}.map-canvas{min-height:24rem}}
</style>

@code {
    private LiveMapDto? map; private bool loading = true; private string? error; private string search = ""; private bool onlineOnly; private List<MapSearchResultDto> results = [];
    private IEnumerable<DriverLocationDto> VisibleDrivers => (map?.Drivers ?? []).Where(x => !onlineOnly || x.IsOnline);
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { loading = true; error = null; try { map = await HttpClientFactory.CreateClient("LondonVIP.Api").GetFromJsonAsync<LiveMapDto>("api/maps"); } catch (Exception ex) { error = ex.Message; } finally { loading = false; } }
    private async Task SearchAsync() { if (string.IsNullOrWhiteSpace(search)) { results = []; return; } results = await HttpClientFactory.CreateClient("LondonVIP.Api").GetFromJsonAsync<List<MapSearchResultDto>>($"api/maps/search?q={Uri.EscapeDataString(search)}") ?? []; }
    private static string MarkerStyle(DriverLocationDto item) { var left = Math.Abs(item.Longitude * 7) % 88 + 4; var top = Math.Abs(item.Latitude * 7) % 78 + 12; return $"left:{left:0.##}%;top:{top:0.##}%"; }
}
