@using LondonVIP.Shared.Dashboard
<article class="chart-card"><header><h2>@Title</h2></header>@if(Points.Count==0||Points.All(x=>x.Value==0)){<p class="empty">No data available.</p>}else{<div class="bars">@foreach(var point in Points){<div title="@point.Value"><i style="height:@Height(point.Value)"></i><span>@point.Label</span><b>@Format(point.Value)</b></div>}</div>}</article>
@code{[Parameter,EditorRequired]public string Title{get;set;}="";[Parameter,EditorRequired]public IReadOnlyList<DashboardChartPointDto> Points{get;set;}=[];[Parameter]public bool Currency{get;set;}private decimal Max=>Points.Count==0?0:Points.Max(x=>x.Value);private string Height(decimal value)=>Max<=0?"0":$"{Math.Max(4,value/Max*100):0.#}%";private string Format(decimal value)=>Currency?value.ToString("C0",System.Globalization.CultureInfo.GetCultureInfo("en-GB")):value.ToString("0.#");}
